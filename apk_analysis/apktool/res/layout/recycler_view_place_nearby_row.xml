<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/product_nearby_name_margin_top_bottom" android:layout_marginBottom="@dimen/product_nearby_name_margin_top_bottom">
        <TextView android:textSize="@dimen/product_nearby_text_size_medium" android:textColor="@color/colorPrimary" android:id="@id/place_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/product_nearby_name_margin_start" />
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/product_nearby_address_margin_top" android:layout_below="@id/place_name">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="@dimen/product_nearby_address_places_icon_size" android:layout_height="@dimen/product_nearby_address_places_icon_size" app:srcCompat="@drawable/places_blue" />
            <TextView android:textSize="@dimen/product_nearby_text_size_small" android:textColor="@color/colorGreyishBlue" android:id="@id/place_address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_top_sm" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>