<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:anim/overshoot_interpolator"
        android:duration="1000"
        android:valueFrom="1"
        android:valueTo="0.99"
        android:valueType="floatType"
        android:propertyName="scaleX"/>
    <objectAnimator
        android:interpolator="@android:anim/overshoot_interpolator"
        android:duration="1000"
        android:valueFrom="1"
        android:valueTo="0.99"
        android:valueType="floatType"
        android:propertyName="scaleY"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="2000"
        android:valueFrom="130"
        android:valueTo="130"
        android:valueType="floatType"
        android:propertyName="pivotX"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="2000"
        android:valueFrom="131"
        android:valueTo="131"
        android:valueType="floatType"
        android:propertyName="pivotY"/>
    <objectAnimator
        android:interpolator="@android:anim/bounce_interpolator"
        android:duration="1000"
        android:startOffset="1000"
        android:valueFrom="0.99"
        android:valueTo="1"
        android:valueType="floatType"
        android:propertyName="scaleX"/>
    <objectAnimator
        android:interpolator="@android:anim/bounce_interpolator"
        android:duration="1000"
        android:startOffset="1000"
        android:valueFrom="0.99"
        android:valueTo="1"
        android:valueType="floatType"
        android:propertyName="scaleY"/>
</set>
