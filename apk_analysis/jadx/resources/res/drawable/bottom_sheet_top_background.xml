<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="@dimen/activity_vertical_margin">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorWhisper"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/activity_vertical_margin"
                android:topRightRadius="@dimen/activity_vertical_margin"/>
            <solid android:color="@color/whiteSmoke"/>
        </shape>
    </item>
</layer-list>
