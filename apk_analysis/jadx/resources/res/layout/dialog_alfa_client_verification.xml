<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_radius_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="@dimen/dimen_280">
    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="@dimen/dimen_24"
        android:layout_height="@dimen/dimen_24"
        android:layout_margin="@dimen/dimen_18"
        android:src="@drawable/ic_close_dear"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/gray_40"/>
    <ImageView
        android:id="@+id/iv_banner"
        android:layout_width="@dimen/dimen_102"
        android:layout_height="@dimen/dimen_80"
        android:layout_marginTop="@dimen/dimen_16"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/new_dialog_done_btn_close_margin"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/dimen_13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_banner"
        style="@style/TextSize22.BlueCharcoal"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:id="@+id/btn_primary"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:layout_marginBottom="@dimen/dimen_24"
        android:layout_marginStart="@dimen/dimen_13"
        android:layout_marginEnd="@dimen/dimen_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/Button.BlueAlice.8dp.Outlined"/>
    <TextView
        android:id="@+id/btn_secondary"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:layout_marginBottom="@dimen/dimen_24"
        android:layout_marginStart="@dimen/dimen_6"
        android:layout_marginEnd="@dimen/dimen_13"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guide"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/Button.BlueAlice.8dp.Outlined"/>
</androidx.constraintlayout.widget.ConstraintLayout>
