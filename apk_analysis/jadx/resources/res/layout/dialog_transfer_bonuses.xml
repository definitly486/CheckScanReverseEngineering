<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorTransparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <View
        android:id="@+id/background"
        android:background="@color/white"
        android:layout_width="@dimen/height_large"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time_expire"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/margin_top_large_sm"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:text="@string/bonuses_temp_code"
        app:layout_constraintBottom_toTopOf="@+id/tv_code"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="36sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_code"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintBottom_toTopOf="@+id/tv_time_expire"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <View
        android:id="@+id/separator"
        android:background="@color/colorBlack50"
        android:layout_width="150sp"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/margin_small_sm"
        app:layout_constraintEnd_toEndOf="@+id/tv_time_expire"
        app:layout_constraintStart_toStartOf="@+id/tv_time_expire"
        app:layout_constraintTop_toBottomOf="@+id/tv_code"/>
    <ProgressBar
        android:id="@+id/pb_loading_code"
        android:visibility="invisible"
        android:layout_width="@dimen/item_bank_options_layout_padding_top"
        android:layout_height="@dimen/item_bank_options_layout_padding_top"
        android:layout_marginTop="@dimen/padding_small_sm"
        app:layout_constraintBottom_toTopOf="@+id/tv_time_expire"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/colorBlack50"
        android:gravity="center"
        android:id="@+id/tv_time_expire"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/btn_load_code"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toBottomOf="@+id/tv_code"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/btn_load_code"
        android:background="@color/readilyBlue"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:text="@string/bonuses_temp_code_load"
        android:lineSpacingExtra="6sp"
        android:paddingHorizontal="@dimen/padding_big_sm"
        android:paddingVertical="@dimen/padding_big_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toBottomOf="@+id/tv_time_expire"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/btn_close"
        android:padding="@dimen/padding_small_sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/content_description_close"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"
        app:srcCompat="@drawable/close_search"/>
</androidx.constraintlayout.widget.ConstraintLayout>
