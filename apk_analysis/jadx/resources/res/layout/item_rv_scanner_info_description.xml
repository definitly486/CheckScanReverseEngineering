<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title"
        android:paddingBottom="@dimen/margin_sm"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large_sm"
        app:layout_constraintStart_toEndOf="@+id/iv_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize18.Medium.ColorTextBody"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColorHighlight="@android:color/transparent"
        android:textColorLink="@color/readilyBlue"
        android:id="@+id/tv_description"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_placeholder"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TextSize16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
