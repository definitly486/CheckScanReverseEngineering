<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_white_background_with_shadow"
    android:paddingTop="@dimen/margin_top_medium_sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_sm"
    android:layout_marginHorizontal="@dimen/margin_sm"
    android:paddingHorizontal="@dimen/margin_large_sm">
    <TextView
        android:id="@+id/tv_admitad_get_cashback_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AdmitadGetCashbackTitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_steps"
        android:paddingBottom="@dimen/margin_top_medium_sm"
        android:clipToPadding="false"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_admitad_get_cashback_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
