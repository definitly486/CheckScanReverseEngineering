<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/share_item_tv_share_option_text_size"
        android:textColor="@color/black"
        android:id="@+id/tv_share_option"
        android:paddingTop="@dimen/share_item_tv_share_option_top_padding"
        android:paddingBottom="@dimen/share_item_tv_share_option_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="textStart"
        android:paddingStart="@dimen/share_item_tv_share_option_start_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/colorWhisper"
        android:layout_width="match_parent"
        android:layout_height="@dimen/share_item_divider_height"
        android:layout_marginBottom="@dimen/share_item_divider_bottom_margin"
        android:layout_marginStart="@dimen/share_item_divider_start_margin"
        android:layout_marginEnd="@dimen/share_item_divider_end_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_option"/>
</androidx.constraintlayout.widget.ConstraintLayout>
