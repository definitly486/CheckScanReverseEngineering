<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/gray_10"
    app:cardCornerRadius="@dimen/dimen_100"
    app:cardElevation="@dimen/dimen_0">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dimen_6">
        <Space
            android:layout_width="@dimen/dimen_8"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/dimen_28"
            android:layout_height="@dimen/dimen_28"
            android:importantForAccessibility="no"/>
        <Space
            android:layout_width="@dimen/dimen_4"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tv_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextSize16.Gray100"/>
        <Space
            android:layout_width="@dimen/dimen_8"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
