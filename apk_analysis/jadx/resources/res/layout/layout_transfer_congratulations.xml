<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/coupon_congratulation_layout_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/coupon_congratulation_layout_padding"
    android:paddingEnd="@dimen/coupon_congratulation_layout_padding">
    <ImageView
        android:id="@+id/iv_congratulations"
        android:visibility="gone"
        android:layout_width="@dimen/coupon_congratulation_iv_congratulations_width_height"
        android:layout_height="@dimen/coupon_congratulation_iv_congratulations_width_height"
        android:layout_marginTop="@dimen/coupon_congratulation_iv_margin_top"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/congr"/>
    <TextView
        android:textSize="@dimen/coupon_congratulation_view_text_size"
        android:textColor="@color/darkCharcoal"
        android:gravity="center"
        android:id="@+id/tv_promo_code_metro"
        android:background="@drawable/rounded_white_smoke_top"
        android:visibility="gone"
        android:layout_width="@dimen/coupon_congratulation_view_width"
        android:layout_height="@dimen/coupon_congratulation_tv_code_height"
        android:layout_marginTop="@dimen/coupon_congratulation_tv_code_margin_top"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_congratulation"/>
    <TextView
        android:textSize="@dimen/coupon_congratulation_view_text_size"
        android:textColor="@color/darkCharcoal"
        android:gravity="center"
        android:id="@+id/btn_copy_code"
        android:background="@drawable/rounded_white_smoke_bottom"
        android:visibility="gone"
        android:layout_width="@dimen/coupon_congratulation_view_width"
        android:layout_height="@dimen/coupon_congratulation_btn_copy_code_height"
        android:text="Скопировать код"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_promo_code_metro"/>
    <TextView
        android:textSize="@dimen/coupon_congratulation_view_text_size"
        android:textColor="@color/darkCharcoal"
        android:gravity="center"
        android:id="@+id/tv_congratulation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coupon_congratulation_tv_congratulation_margin_top"
        android:text="Поздравляем! Вы получили промокод  на скидку N рублей в METRO!"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_congratulations"/>
</androidx.constraintlayout.widget.ConstraintLayout>
