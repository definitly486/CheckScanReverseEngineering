<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statistic_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/pb_loading_statistics"
            android:visibility="gone"
            android:layout_width="@dimen/statistics_fragment_pb_loading_statistics_width"
            android:layout_height="@dimen/statistics_fragment_pb_loading_statistics_height"
            android:indeterminate="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <include
            android:id="@+id/categories_layout"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="@dimen/statistics_fragment_categories_layout_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_vertical_margin"
            android:layout_marginEnd="@dimen/activity_vertical_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/categories_statistics_layout"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_retailers"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/statistics_fragment_rv_retailers_margin_top"
            android:layout_marginStart="@dimen/statistics_fragment_view_margin_start_end"
            android:layout_marginEnd="@dimen/statistics_fragment_view_margin_start_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_shops"/>
        <TextView
            android:textSize="@dimen/statistics_fragment_tv_shops_text_size"
            android:textColor="@color/blueCharcoal"
            android:id="@+id/tv_shops"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/statistics_fragment_tv_shops_margin_top"
            android:text="@string/statistics_shops"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="@dimen/statistics_fragment_view_margin_start_end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/categories_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
