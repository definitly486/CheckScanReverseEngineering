<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_12"
    android:layout_marginHorizontal="@dimen/dimen_8"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dimen_16"
    app:cardElevation="@dimen/dimen_0"
    app:strokeColor="@color/athensGrayButton"
    app:strokeWidth="@dimen/dimen_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="@dimen/dimen_100"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_title_background"
            android:background="@drawable/background_group_shops"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="@dimen/dimen_16"
            app:layout_constraintBottom_toTopOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16"
            app:layout_constraintEnd_toStartOf="@+id/btn_check_more"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_logo"
            style="@style/TextSize18.Medium.BlueCharcoal"/>
        <TextView
            android:gravity="end"
            android:id="@+id/btn_check_more"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_16"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            style="@style/TextSize16.Medium.ReadilyBlue"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/table"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:layout_marginBottom="@dimen/dimen_24"
            android:layout_marginHorizontal="@dimen/dimen_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <include
                android:id="@+id/first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/item_rv_shops_preview_rectangle"/>
            <include
                android:id="@+id/second"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                layout="@layout/item_rv_shops_preview_rectangle"/>
            <include
                android:id="@+id/third"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                layout="@layout/item_rv_shops_preview_rectangle"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
