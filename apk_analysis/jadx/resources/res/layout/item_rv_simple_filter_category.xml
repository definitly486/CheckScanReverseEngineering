<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_sm">
    <TextView
        android:id="@+id/tv_simple_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/checkbox_simple"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FilterTextTitle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="checkbox_simple"/>
    <CheckBox
        android:textSize="@dimen/text_size_medium_small_sm"
        android:id="@+id/checkbox_simple"
        android:paddingTop="@dimen/margin_small_2_sm"
        android:paddingBottom="@dimen/margin_small_2_sm"
        android:clickable="false"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:button="@drawable/chekbox_checked"
        android:buttonTint="@color/white"
        android:buttonTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/manatee"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/margin_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkbox_simple"/>
</androidx.constraintlayout.widget.ConstraintLayout>
