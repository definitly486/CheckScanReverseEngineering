<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/athensGray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_empty_cheques_title"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_32"
        android:text="@string/cheque_empty_title"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/dimen_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize22.BlueCharcoal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_empty_cheques_description"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:text="@string/cheque_empty_description"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/dimen_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_empty_cheques_title"
        style="@style/TextSize16.ColorTextBody"/>
    <ImageView
        android:id="@+id/iv_go_scan"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        android:layout_marginTop="@dimen/dimen_32"
        android:layout_marginBottom="@dimen/dimen_24"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginHorizontal="@dimen/dimen_32"
        app:layout_constraintBottom_toTopOf="@+id/tv_empty_cheques_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_empty_cheques_description"
        app:srcCompat="@drawable/ic_empty_scan"/>
    <TextView
        android:id="@+id/tv_empty_cheques_subtitle"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_87"
        android:text="@string/cheque_empty_subtitle"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/dimen_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TextSize16.ColorTextBody"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/layout_cheques"
        android:visibility="visible"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbars"
            android:background="@color/athensGray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="@dimen/dimen_0">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="snap|scroll">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_your_electric_checks"
                    android:background="@drawable/rounded_white_background"
                    android:paddingTop="@dimen/dimen_12"
                    android:paddingBottom="@dimen/dimen_12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_20"
                    android:layout_marginStart="@dimen/dimen_16"
                    android:layout_marginEnd="@dimen/dimen_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/pb_electric_checks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:indeterminate="false"
                        android:indeterminateOnly="true"
                        android:layout_marginStart="@dimen/dimen_24"
                        app:indicatorColor="@color/readilyBlue"
                        app:indicatorDirectionCircular="clockwise"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:trackColor="@color/very_light_blue"
                        app:trackCornerRadius="@dimen/dimen_50"
                        app:trackThickness="@dimen/dimen_6"/>
                    <TextView
                        android:textColor="@color/blueCharcoal"
                        android:id="@+id/tv_your_checks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/your_electrocheque_loading"
                        android:fontFamily="@font/roboto_reg"
                        android:layout_marginStart="@dimen/dimen_16"
                        app:layout_constraintBottom_toBottomOf="@+id/pb_electric_checks"
                        app:layout_constraintStart_toEndOf="@+id/pb_electric_checks"
                        app:layout_constraintTop_toTopOf="@+id/pb_electric_checks"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_your_statistics"
                    android:background="@drawable/rounded_very_light_blue_background"
                    android:paddingTop="@dimen/dimen_11"
                    android:paddingBottom="@dimen/dimen_11"
                    android:visibility="visible"
                    android:paddingStart="@dimen/dimen_16"
                    android:paddingEnd="@dimen/dimen_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_all_banners"
                    style="@style/Layout">
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@+id/guideline3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintGuide_percent="0.61"/>
                    <ImageView
                        android:id="@+id/iv_statistics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_1"
                        android:layout_marginBottom="@dimen/dimen_1"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_statistics"/>
                    <TextView
                        android:textColor="@color/darkCharcoal"
                        android:id="@+id/tv_statistics_value"
                        android:layout_width="@dimen/dimen_0"
                        android:layout_marginStart="@dimen/dimen_15"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_statistics"
                        app:layout_constraintEnd_toStartOf="@+id/guideline3"
                        app:layout_constraintStart_toEndOf="@+id/iv_statistics"
                        app:layout_constraintTop_toTopOf="@+id/iv_statistics"
                        style="@style/style_cheques"/>
                    <TextView
                        android:id="@+id/tv_spent_for_month"
                        android:layout_height="wrap_content"
                        android:lines="2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Title.Main.FillWidth"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_all_banners"
                    android:visibility="visible"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_your_electric_checks"
                    style="@style/Layout">
                    <include
                        android:id="@+id/view_banner"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/banner_layout"/>
                    <include
                        android:id="@+id/view_poll"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/item_poll"/>
                    <include
                        android:id="@+id/view_survey"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/item_poll_baner"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/layout_alfa_progress"
                    android:visibility="gone"
                    android:layout_width="@dimen/dimen_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_32"
                    android:layout_marginHorizontal="@dimen/dimen_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_your_statistics"
                    layout="@layout/item_cheques_progress_alfa"/>
                <TextView
                    android:textColor="@color/blueCharcoal"
                    android:id="@+id/tv_cheques"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_32"
                    android:text="@string/title_my_cheques"
                    app:layout_constraintStart_toStartOf="@+id/layout_your_statistics"
                    app:layout_constraintTop_toBottomOf="@+id/layout_alfa_progress"
                    style="@style/style_cheques"/>
                <TextView
                    android:textSize="@dimen/fragment_cheques_btn_export_text_size"
                    android:textColor="@color/readilyBlue"
                    android:id="@+id/btn_export_cheques"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cheques_export_cheques"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_marginEnd="@dimen/dimen_15"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_cheques"/>
                <include
                    android:id="@+id/incld_ad_wide_banner_with_ord"
                    android:visibility="gone"
                    android:layout_width="@dimen/dimen_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16"
                    android:layout_marginHorizontal="@dimen/dimen_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_cheques"
                    layout="@layout/layout_ad_wide_banner_with_ord"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_you_have_missed"
                    android:background="@drawable/rounded_radius_10_chabils"
                    android:paddingTop="@dimen/dimen_12"
                    android:paddingBottom="@dimen/dimen_12"
                    android:visibility="gone"
                    android:layout_width="@dimen/fragment_cheques_view_width"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16"
                    android:paddingStart="@dimen/dimen_16"
                    android:paddingEnd="@dimen/dimen_16"
                    app:layout_constraintEnd_toEndOf="@+id/btn_export_cheques"
                    app:layout_constraintStart_toStartOf="@+id/tv_cheques"
                    app:layout_constraintTop_toBottomOf="@+id/incld_ad_wide_banner_with_ord">
                    <ImageView
                        android:id="@+id/iv_you_have_missed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_infor_not_acceptable"/>
                    <TextView
                        android:textColor="@color/red"
                        android:id="@+id/tv_you_have_missed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cheques_you_have_missed"
                        android:fontFamily="@font/roboto_reg"
                        android:layout_marginStart="@dimen/dimen_8"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_you_have_missed"
                        app:layout_constraintStart_toEndOf="@+id/iv_you_have_missed"
                        app:layout_constraintTop_toTopOf="@+id/iv_you_have_missed"/>
                    <ImageView
                        android:id="@+id/btn_you_have_missed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_2"
                        android:layout_marginBottom="@dimen/dimen_2"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_arrow_right_red"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sorts"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_cheques2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_0"
                android:layout_marginTop="@dimen/dimen_16"
                android:overScrollMode="never"
                android:layout_marginStart="@dimen/dimen_16"
                android:layout_marginEnd="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_sorts"/>
            <ImageView
                android:id="@+id/iv_no_receipts"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_32"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_sorts"
                app:srcCompat="@drawable/ic_cheques_not_found"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_empty"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        app:constraint_referenced_ids="tv_empty_cheques_title,tv_empty_cheques_description,iv_go_scan, tv_empty_cheques_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
