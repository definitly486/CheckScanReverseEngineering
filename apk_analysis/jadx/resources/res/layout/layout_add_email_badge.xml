<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/warning10"
    app:cardCornerRadius="@dimen/dimen_16"
    app:cardElevation="@dimen/dimen_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/dimen_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_warning"
            android:layout_width="@dimen/dimen_32"
            android:layout_height="@dimen/dimen_32"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_triangle_warning"
            app:tint="@color/warning80"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:text="@string/add_email_badge_title"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_marginEnd="@dimen/dimen_8"
            app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
            app:layout_constraintStart_toEndOf="@+id/iv_warning"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextSize16.Gray100"/>
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:text="@string/add_email_badge_description"
            android:layout_marginEnd="@dimen/dimen_8"
            app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/TextSize14.Gray60"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:src="@drawable/ic_right"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/warning80"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
