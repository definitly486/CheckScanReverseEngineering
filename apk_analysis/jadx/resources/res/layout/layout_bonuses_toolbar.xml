<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_content"
    android:background="@color/white"
    android:paddingTop="@dimen/dimen_10"
    android:paddingBottom="@dimen/dimen_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dimen_56"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/btn_notifications"
        android:layout_width="@dimen/dimen_44"
        android:layout_height="@dimen/dimen_44"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_notifications"/>
    <ImageView
        android:id="@+id/iv_bell_red_dot"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_12"
        android:layout_height="@dimen/dimen_12"
        android:layout_marginTop="@dimen/dimen_8"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/dimen_11"
        app:layout_constraintEnd_toEndOf="@+id/btn_notifications"
        app:layout_constraintTop_toTopOf="@+id/btn_notifications"
        app:srcCompat="@drawable/circle_pulse_animated"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_search"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_40"
        android:layout_marginStart="@dimen/dimen_12"
        android:layout_marginEnd="@dimen/dimen_12"
        app:cardBackgroundColor="@color/gray_10"
        app:cardCornerRadius="@dimen/dimen_12"
        app:cardElevation="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_profile"
        app:layout_constraintStart_toEndOf="@+id/iv_bell_red_dot"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/gray_40"
            android:gravity="center_vertical"
            android:id="@+id/tv_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/choose_region_search_hint2"
            android:drawablePadding="10dp"
            android:paddingStart="@dimen/dimen_12"
            app:drawableStartCompat="@drawable/ic_searh_loop"
            app:drawableTint="@color/gray_40"/>
    </com.google.android.material.card.MaterialCardView>
    <com.warefly.checkscan.subscription.presentation.badge.ProfileBadgeView
        android:id="@+id/btn_profile"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_40"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/dimen_8"
        app:badgeType="Pro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
