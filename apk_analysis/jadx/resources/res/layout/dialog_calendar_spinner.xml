<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_large_sm">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="start"
            android:id="@+id/btn_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/picker_cancel"
            android:layout_weight="1"
            android:paddingVertical="@dimen/margin_large_sm"
            style="@style/TextSize16.Medium.ReadilyBlue"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end"
            android:id="@+id/btn_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/picker_approve"
            android:layout_weight="1"
            android:paddingVertical="@dimen/margin_large_sm"
            style="@style/TextSize16.Medium.ReadilyBlue"/>
    </LinearLayout>
    <com.warefly.checkscan.calendarspinner.DateTimePickerSpinner
        android:id="@+id/calendar_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:picker_curved="true"
        app:picker_cyclic="true"
        app:picker_selectedTextColor="@color/blueCharcoal"
        app:picker_textSize="24sp"
        app:picker_visibleItemCount="9"/>
</LinearLayout>
