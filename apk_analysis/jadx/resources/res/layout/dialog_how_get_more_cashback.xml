<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_header"
        android:background="@drawable/bottom_sheet_top_background"
        android:layout_width="@dimen/date_sort_view_header_width"
        android:layout_height="@dimen/date_sort_view_header_height"
        app:layout_constraintBottom_toBottomOf="@+id/tv_dialog_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_dialog_header"
        android:layout_width="@dimen/date_sort_tv_dialog_header_width"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:paddingVertical="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize18.Medium.BlueCharcoal"/>
    <View
        android:id="@+id/divider"
        android:background="@color/colorWhisper"
        android:layout_width="@dimen/date_sort_divider_width"
        android:layout_height="@dimen/date_sort_divider_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_header"/>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="@dimen/date_sort_btn_close_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/content_description_close"
        app:layout_constraintBottom_toBottomOf="@+id/tv_dialog_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_dialog_header"
        app:srcCompat="@drawable/ic_close_blue"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:paddingTop="@dimen/margin_sm"
        android:paddingBottom="@dimen/margin_height_large"
        android:clipToPadding="false"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        android:paddingHorizontal="@dimen/margin_large_sm"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/btn_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_header"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_action"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_top_large_sm"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BlueButtonRadius8"/>
</androidx.constraintlayout.widget.ConstraintLayout>
