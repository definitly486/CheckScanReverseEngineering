<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="@dimen/margin_large_sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_name"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        app:layout_constraintEnd_toStartOf="@+id/barrier_sum"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Title.Main"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_sum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="tv_sum_word,tv_price_units"/>
    <TextView
        android:id="@+id/tv_sum_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_name"
        style="@style/Title.Primary"/>
    <TextView
        android:id="@+id/tv_price_units"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_more_little_bit"
        app:layout_constraintEnd_toEndOf="@+id/tv_sum_word"
        app:layout_constraintTop_toBottomOf="@+id/tv_sum_word"
        style="@style/Title.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
