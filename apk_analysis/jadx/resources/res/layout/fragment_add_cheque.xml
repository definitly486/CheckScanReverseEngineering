<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/whiteSmoke"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/fragment_add_cheques_btn_back_width"
                android:layout_height="@dimen/fragment_add_cheques_btn_back_height"
                android:layout_centerVertical="true"
                android:contentDescription="@string/content_description_back"
                android:layout_marginStart="@dimen/activity_vertical_margin"
                app:layout_constraintBottom_toBottomOf="@+id/toolbar_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/toolbar_title"
                app:srcCompat="@drawable/ic_arrow_left_blue"/>
            <TextView
                android:textSize="@dimen/fragment_add_cheque_toolbar_title_text_size"
                android:textColor="@color/black"
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fragment_add_cheque_toolbar_title_top_margin"
                android:layout_marginBottom="@dimen/fragment_add_cheque_toolbar_title_bottom_margin"
                android:layout_centerVertical="true"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/btn_delete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:layout_marginEnd="@dimen/activity_vertical_margin"
                app:layout_constraintBottom_toBottomOf="@+id/toolbar_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/toolbar_title"
                app:srcCompat="@drawable/ic_delete_blue"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/queue_cheque_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/incld_header"
                android:layout_width="@dimen/reject_cheques_0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large_sm"
                android:layout_marginStart="@dimen/margin_sm"
                android:layout_marginEnd="@dimen/margin_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/rejected_receipt_layout"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_receipt_data"
                android:background="@drawable/card_block_background"
                android:visibility="gone"
                android:layout_width="@dimen/reject_cheques_0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_sm"
                android:layout_marginBottom="@dimen/margin_large_sm"
                android:layout_marginStart="@dimen/margin_sm"
                android:layout_marginEnd="@dimen/margin_sm"
                app:cardCornerRadius="@dimen/card_block_radius"
                app:cardElevation="@dimen/card_block_elevation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/incld_header"
                app:layout_constraintVertical_bias="0">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingTop="@dimen/padding_big_sm"
                    android:paddingBottom="@dimen/margin_large_sm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_receipt_data_title"
                        android:layout_width="@dimen/reject_cheques_0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/margin_large_sm"
                        android:layout_marginEnd="@dimen/margin_sm"
                        app:layout_constraintEnd_toStartOf="@+id/tv_receipt_data_sum"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Header"/>
                    <TextView
                        android:id="@+id/tv_receipt_data_sum"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginEnd="@dimen/margin_large_sm"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_receipt_data_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_receipt_data_title"
                        style="@style/Header"/>
                    <ImageView
                        android:id="@+id/iv_receipt_data_qr"
                        android:layout_width="@dimen/image_side_middle"
                        android:layout_height="@dimen/image_side_middle"
                        android:layout_marginTop="@dimen/padding_big_sm"
                        android:contentDescription="@string/content_description_qr_code"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_receipt_data_title"/>
                    <include
                        android:id="@+id/layout_receipt_data_qr_info"
                        android:layout_width="@dimen/reject_cheques_0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_big_sm"
                        android:layout_marginStart="@dimen/margin_large_sm"
                        android:layout_marginEnd="@dimen/margin_large_sm"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_receipt_data_qr"
                        layout="@layout/layout_qr_info"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
