<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:animateLayoutChanges="true">
    <androidx.camera.view.PreviewView
        android:id="@+id/view_preview"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_close_white_48"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/margin_large_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gl_top"/>
    <ImageView
        android:id="@+id/iv_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/margin_sm"
        app:layout_constraintEnd_toStartOf="@+id/iv_info"
        app:layout_constraintTop_toTopOf="@+id/gl_top"
        app:srcCompat="@drawable/ic_flash_white_48"
        app:tint="@color/colorAccent"/>
    <ImageView
        android:id="@+id/iv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_info_white_48"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gl_top"/>
    <ImageView
        android:id="@+id/iv_scanner_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:src="@drawable/ic_scanner_frame"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/barrier_top_buttons"/>
    <include
        android:id="@+id/message"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_enormous_sm"
        app:layout_constraintBottom_toBottomOf="@+id/iv_scanner_frame"
        app:layout_constraintEnd_toEndOf="@+id/iv_scanner_frame"
        app:layout_constraintStart_toStartOf="@+id/iv_scanner_frame"
        layout="@layout/item_message"/>
    <include
        android:id="@+id/message_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_enormous_sm"
        app:layout_constraintBottom_toBottomOf="@+id/iv_scanner_frame"
        app:layout_constraintEnd_toEndOf="@+id/iv_scanner_frame"
        app:layout_constraintStart_toStartOf="@+id/iv_scanner_frame"
        layout="@layout/item_message_error"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_content"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_big_sm"
        android:paddingStart="@dimen/padding_big_sm"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_scanner_frame"/>
    <include
        android:id="@+id/tv_cheque_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_content"
        app:layout_goneMarginTop="@dimen/margin_big_sm"
        layout="@layout/item_cheque_with_count"/>
    <ImageView
        android:id="@+id/iv_brandlink"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:src="@drawable/image_brandlink_banner"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_cheque_info"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_load"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_2_sm"
        android:text="@string/scanner_button_load_title"
        app:layout_constraintEnd_toEndOf="@+id/iv_scanner_frame"
        app:layout_constraintStart_toStartOf="@+id/iv_scanner_frame"
        app:layout_constraintTop_toBottomOf="@+id/iv_brandlink"
        style="@style/Button.Blue"/>
    <ImageView
        android:id="@+id/iv_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_sm"
        android:src="@drawable/ic_gallery_white_48"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/margin_large_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_manual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scanner_add_to_manual"
        android:maxLines="1"
        android:drawablePadding="@dimen/margin_more_little_bit"
        android:drawableEnd="@drawable/ic_arrow_right_fill_white_24"
        android:layout_marginEnd="@dimen/margin_big_sm"
        app:layout_constraintBottom_toBottomOf="@+id/iv_gallery"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_gallery"
        style="@style/TextSize16.Medium.White"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_top_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_close,iv_flash,iv_info"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gl_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/margin_sm"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_cheques"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_cheque_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
