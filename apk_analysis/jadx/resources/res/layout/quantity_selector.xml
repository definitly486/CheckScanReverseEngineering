<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/quantity_selector_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="38sp"
        android:minHeight="38sp"
        android:animateLayoutChanges="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/view_unchecked_background"
            android:background="@drawable/quantity_selector_unchecked_background"
            android:visibility="visible"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="@dimen/fill_free_space"
            android:layout_margin="@dimen/margin_little_bit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_minus"
            android:padding="@dimen/margin_top_sm"
            android:paddingBottom="@dimen/margin_end_sm"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_delete"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_remove"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorBlack40"
            android:gravity="center_horizontal"
            android:id="@+id/tv_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_sm"
            android:layout_marginBottom="@dimen/margin_end_sm"
            android:minWidth="18sp"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/margin_top_sm"
            android:layout_marginEnd="@dimen/margin_top_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_plus"
            app:layout_constraintStart_toEndOf="@+id/btn_minus"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_plus"
            android:padding="@dimen/margin_top_sm"
            android:paddingBottom="@dimen/margin_end_sm"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_quantity"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_add"/>
        <ImageView
            android:id="@+id/btn_delete"
            android:padding="@dimen/margin_top_sm"
            android:paddingBottom="@dimen/margin_end_sm"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="45"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_add"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/view_checked"
        android:background="@drawable/quantity_selector_checked_background"
        android:padding="@dimen/margin_sm"
        android:visibility="invisible"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_done_white"/>
    <View
        android:id="@+id/btn_check"
        android:visibility="visible"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
