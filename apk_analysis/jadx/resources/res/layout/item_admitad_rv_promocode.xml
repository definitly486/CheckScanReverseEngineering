<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ic_promocode_background"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dimen_280"
    android:layout_marginStart="@dimen/margin_large_sm">
    <ImageView
        android:id="@+id/iv_shop"
        android:layout_width="@dimen/dimen_60"
        android:layout_height="@dimen/dimen_60"
        android:layout_marginTop="@dimen/dimen_12"
        android:contentDescription="@null"
        android:layout_marginHorizontal="@dimen/dimen_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/btn_favourite_coupon"
        android:background="@color/colorTransparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_13"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_favorite"/>
    <TextView
        android:id="@+id/tv_shop_name"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/tv_category"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_shop"
        style="@style/TextSize16.Medium.BlueCharcoal"/>
    <TextView
        android:id="@+id/tv_category"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shop_name"
        style="@style/TextSize14.Manatee"/>
    <ImageView
        android:id="@+id/divider"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_2"
        android:layout_marginTop="@dimen/dimen_136"
        android:layout_marginBottom="@dimen/dimen_124"
        android:src="@drawable/dashed_line"
        android:contentDescription="@null"
        android:layout_marginHorizontal="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/readilyBlue"
        android:ellipsize="end"
        android:id="@+id/tv_discount"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:maxLines="2"
        android:fontFamily="@font/roboto_medium"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dimen_12"
        android:layout_marginEnd="@dimen/dimen_12"
        android:layout_marginHorizontal="@dimen/dimen_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_subcategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginBottom="@dimen/dimen_16"
        android:maxLines="2"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/tv_discount"
        app:layout_constraintStart_toStartOf="@+id/tv_discount"
        app:layout_constraintTop_toBottomOf="@+id/tv_discount"
        style="@style/TextSize14.Manatee"/>
    <TextView
        android:id="@+id/tv_expiration"
        android:background="@drawable/badge_background"
        android:paddingTop="@dimen/dimen_4"
        android:paddingBottom="@dimen/dimen_4"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:layout_marginBottom="@dimen/dimen_12"
        android:maxLines="1"
        android:paddingStart="@dimen/dimen_8"
        android:paddingEnd="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_subcategory"
        style="@style/TextSize14.ColorTextBody"/>
</androidx.constraintlayout.widget.ConstraintLayout>
