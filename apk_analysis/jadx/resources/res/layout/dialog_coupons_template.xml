<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view"
        android:background="@drawable/bottom_sheet_top_background"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/incld_transfer_congratulation_view"
        android:visibility="gone"
        layout="@layout/layout_transfer_congratulations"/>
    <include
        android:id="@+id/incld_coupon_transfer_view"
        android:visibility="visible"
        layout="@layout/layout_coupon_transfer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
