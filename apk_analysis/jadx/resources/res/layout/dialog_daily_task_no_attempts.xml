<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.warefly.checkscan.core.ui.SmartNestedScrollView
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        android:layout_marginBottom="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/btn_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_image"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="@dimen/dimen_0"
                android:layout_marginTop="@dimen/dimen_118"
                android:contentDescription="@null"
                android:layout_marginHorizontal="@dimen/dimen_24"
                app:layout_constraintDimensionRatio="327:260"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="@dimen/fill_free_space"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/dimen_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_image"
                style="@style/TextSize24.BlueCharcoal.Height28"/>
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="@dimen/fill_free_space"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/dimen_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/TextSize16.BlueCharcoal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.warefly.checkscan.core.ui.SmartNestedScrollView>
    <TextView
        android:id="@+id/btn_action"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_40"
        android:layout_marginHorizontal="@dimen/dimen_24"
        android:paddingHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Button.Blue.8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
