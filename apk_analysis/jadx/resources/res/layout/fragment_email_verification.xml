<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/btn_back"
        android:padding="@dimen/margin_small_sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:text="@string/verification_email_title"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"
        style="@style/TextSize22.Gray100"/>
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TextSize16.Gray60"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_codes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle">
        <EditText
            android:id="@+id/et_code_one_call"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:textIsSelectable="true"
            android:autofillHints="AUTOFILL_HINT_SMS_OTP"
            android:importantForAutofill="no"
            style="@style/TextInputLayoutOtp"/>
        <EditText
            android:id="@+id/et_code_two_call"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/dimen_10"
            android:importantForAutofill="no"
            style="@style/TextInputLayoutOtp"/>
        <EditText
            android:id="@+id/et_code_three_call"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/dimen_10"
            android:importantForAutofill="no"
            style="@style/TextInputLayoutOtp"/>
        <EditText
            android:id="@+id/et_code_four_call"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/dimen_10"
            android:importantForAutofill="no"
            style="@style/TextInputLayoutOtp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_otp_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:text="@string/verification_otp_error"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_codes"
        style="@style/TextSize14.Red60"/>
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_32"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_otp_error"
        style="@style/TextSize16.Gray60"/>
    <TextView
        android:id="@+id/btn_send_code_again"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_32"
        android:text="@string/verification_button_sms_retry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_timer"
        style="@style/TextSize16.Blue60"/>
    <TextView
        android:id="@+id/btn_verify"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_32"
        android:text="@string/verification_email_button_text"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_send_code_again"
        style="@style/Button.Primary60.8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
