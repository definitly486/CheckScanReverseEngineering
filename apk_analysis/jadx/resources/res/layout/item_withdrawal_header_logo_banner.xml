<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_background"
        android:background="@drawable/background_blue_alice_radius_12_with_border"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        android:layout_marginTop="@dimen/dimen_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_logo"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/dimen_114"
        android:layout_height="@dimen/dimen_72"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_alfa_card"/>
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:layout_marginHorizontal="@dimen/dimen_12"
        app:layout_constraintBottom_toTopOf="@+id/tv_value"
        app:layout_constraintEnd_toStartOf="@+id/iv_click"
        app:layout_constraintStart_toStartOf="@+id/view_background"
        app:layout_constraintTop_toBottomOf="@+id/iv_logo"
        style="@style/TextSize14.ColorTextBody"/>
    <TextView
        android:id="@+id/tv_value"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_12"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintEnd_toStartOf="@+id/iv_click"
        app:layout_constraintStart_toStartOf="@+id/view_background"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"
        style="@style/TextSize22.BlueCharcoal"/>
    <Space
        android:id="@+id/bottom_space"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/view_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_value"/>
    <ImageView
        android:id="@+id/iv_click"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_12"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/view_background"
        app:layout_constraintEnd_toEndOf="@+id/view_background"
        app:srcCompat="@drawable/ic_circle_arrow_click"/>
</androidx.constraintlayout.widget.ConstraintLayout>
