<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/dimen_16"
    app:cardElevation="@dimen/dimen_0"
    app:strokeColor="@color/primary_20"
    app:strokeWidth="@dimen/dimen_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/dimen_44"
            android:layout_height="@dimen/dimen_44"
            android:layout_marginTop="@dimen/dimen_16"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/dimen_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:layout_marginStart="@dimen/dimen_12"
            app:layout_constraintEnd_toStartOf="@+id/btn_arrow"
            app:layout_constraintStart_toEndOf="@+id/iv_logo"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextSize18.Medium.BlueCharcoal"/>
        <TextView
            android:id="@+id/tv_subtitle"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_12"
            app:layout_constraintEnd_toStartOf="@+id/btn_arrow"
            app:layout_constraintStart_toEndOf="@+id/iv_logo"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/TextSize16.BlueCharcoal"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_badges"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8"
            android:layout_marginStart="@dimen/dimen_12"
            android:nestedScrollingEnabled="false"
            app:layout_constraintBottom_toTopOf="@+id/tv_counter"
            app:layout_constraintEnd_toStartOf="@+id/btn_arrow"
            app:layout_constraintStart_toEndOf="@+id/iv_logo"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"/>
        <View
            android:id="@+id/clickable_rv"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="@dimen/dimen_0"
            app:layout_constraintBottom_toBottomOf="@+id/rv_badges"
            app:layout_constraintEnd_toEndOf="@+id/rv_badges"
            app:layout_constraintStart_toStartOf="@+id/rv_badges"
            app:layout_constraintTop_toTopOf="@+id/rv_badges"/>
        <TextView
            android:id="@+id/tv_counter"
            android:paddingTop="@dimen/dimen_8"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/btn_claim_reward"
            app:layout_constraintEnd_toStartOf="@+id/btn_arrow"
            app:layout_constraintStart_toStartOf="@+id/rv_badges"
            app:layout_constraintTop_toBottomOf="@+id/rv_badges"/>
        <com.warefly.checkscan.core.ui.LoadingButton
            android:enabled="true"
            android:id="@+id/btn_claim_reward"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8"
            android:text="@string/task_card_take_reward_button"
            android:paddingHorizontal="@dimen/dimen_16"
            app:layout_constraintBottom_toTopOf="@+id/bottom_spacer"
            app:layout_constraintStart_toStartOf="@+id/rv_badges"
            app:layout_constraintTop_toBottomOf="@+id/tv_counter"
            app:loadingDrawableResource="@drawable/loading_circles_8dp"
            app:regularDrawableResource="@drawable/primary60_button_8dp"
            style="@style/Button.Blue.8dp"/>
        <Space
            android:id="@+id/bottom_spacer"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/fade_background"
            android:background="@color/white_alpha_90"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="@dimen/dimen_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_arrow"
            android:layout_width="@dimen/dimen_32"
            android:layout_height="@dimen/dimen_32"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/dimen_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_right"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
