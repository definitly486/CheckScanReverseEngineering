<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_badge_product_offers_container"
    android:background="@drawable/background_white_radius_10_stroke_1"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_badge_product_layout_height"
    android:layout_marginTop="@dimen/item_badge_product_layout_margin_top"
    android:layout_marginBottom="@dimen/margin_big_sm"
    android:layout_marginStart="@dimen/item_badge_product_layout_margin_start_end"
    android:layout_marginEnd="@dimen/item_badge_product_layout_margin_start_end"
    android:paddingHorizontal="@dimen/item_badge_product_layout_padding_horizontal">
    <ImageView
        android:id="@+id/iv_open_offers"
        android:paddingTop="@dimen/item_badge_product_iv_open_offers_padding_top_bottom"
        android:paddingBottom="@dimen/item_badge_product_iv_open_offers_padding_top_bottom"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/item_badge_product_iv_open_offers_height"
        android:contentDescription="@null"
        android:paddingStart="@dimen/item_badge_product_iv_open_offers_padding_start_end"
        android:paddingEnd="@dimen/item_badge_product_iv_open_offers_padding_start_end"
        app:layout_constraintBottom_toBottomOf="@+id/rv_offers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rv_offers"
        app:srcCompat="@drawable/ic_arrow_right"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_offers_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/margin_small_sm"
        app:layout_constraintBottom_toBottomOf="@+id/rv_offers"
        app:layout_constraintEnd_toEndOf="@+id/iv_open_offers"
        app:layout_constraintStart_toEndOf="@+id/rv_offers"
        app:layout_constraintTop_toTopOf="@+id/rv_offers"
        style="@style/ProductOffersTitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_offers"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/margin_space_sm"
        android:layout_marginTop="@dimen/margin_small_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/btn_badge_pin_hint"
        android:background="@drawable/pin_animated"
        android:visibility="gone"
        android:layout_width="@dimen/margin_fourty_full_average"
        android:layout_height="@dimen/margin_fourty_full_average"
        android:scaleType="centerCrop"
        android:layout_centerInParent="true"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/tv_offers_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.85"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
