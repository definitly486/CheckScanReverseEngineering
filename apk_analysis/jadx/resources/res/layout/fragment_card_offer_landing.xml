<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coord_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar_banner"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/fill_free_space">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/appbar"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/white"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <com.warefly.checkscan.core.ui.SafeImageView
                android:id="@+id/iv_banner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:minHeight="@dimen/min_height_image_offer"
                android:contentDescription="@null"
                app:layout_collapseMode="parallax"/>
            <com.warefly.checkscan.shimmer.ShimmerFrameLayout
                android:id="@+id/iv_loading"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_height_image_offer"
                app:layout_collapseMode="parallax">
                <FrameLayout
                    android:background="@drawable/background_shimmer_rectangle_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.warefly.checkscan.shimmer.ShimmerFrameLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:background="@color/white"
        android:paddingTop="@dimen/margin_top_medium_sm"
        android:paddingBottom="@dimen/margin_top_big"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/margin_large_sm"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"/>
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_big_sm"
        android:src="@drawable/ic_back_button"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/margin_sm"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/layout_button_issue_card"
        android:background="@color/white"
        android:paddingTop="@dimen/margin_sm"
        android:paddingBottom="@dimen/margin_enormous_sm"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_large_sm">
        <TextView
            android:id="@+id/btn_issue_card"
            android:paddingTop="@dimen/margin_more_large_sm"
            android:paddingBottom="@dimen/margin_more_large_sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Button.Blue"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
