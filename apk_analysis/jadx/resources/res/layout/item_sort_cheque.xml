<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip_cheque"
    android:background="@drawable/item_sort_cheque_background"
    android:paddingTop="@dimen/item_sort_cheque_layout_by_sort_padding_top_bottom"
    android:paddingBottom="@dimen/item_sort_cheque_layout_by_sort_padding_top_bottom"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/item_sort_cheque_layout_by_sort_layout_height"
    android:paddingStart="@dimen/item_sort_cheque_layout_by_sort_padding_start_end"
    android:paddingEnd="@dimen/item_sort_cheque_layout_by_sort_padding_start_end"
    android:layout_marginStart="@dimen/item_sort_cheque_layout_by_sort_margin_end">
    <ImageView
        android:id="@+id/iv_by_sort"
        android:visibility="gone"
        android:layout_width="@dimen/margin_large_sm"
        android:layout_height="@dimen/margin_large_sm"
        android:contentDescription="@null"
        android:paddingEnd="@dimen/item_sort_cheque_iv_by_sort_padding_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/item_sort_filter"/>
    <TextView
        android:id="@+id/tv_by_sort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_sort_cheque_tv_by_sort_margin_bottom"
        android:fontFamily="@font/roboto_reg"
        android:textAlignment="gravity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_by_sort"
        style="@style/SortText"/>
    <ImageView
        android:id="@+id/btn_by_sort"
        android:layout_width="@dimen/margin_large_sm"
        android:layout_height="@dimen/margin_large_sm"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/item_sort_cheque_btn_by_sort_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_by_sort"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/item_button_sort"/>
</androidx.constraintlayout.widget.ConstraintLayout>
