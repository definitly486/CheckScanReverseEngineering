<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/darkCharcoal80"
        android:id="@+id/tv_coupon_three"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coupon_transfer_tv_margin_top_start"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintEnd_toEndOf="@+id/btn_coupon_three"
        app:layout_constraintStart_toStartOf="@+id/btn_coupon_three"
        app:layout_constraintTop_toBottomOf="@+id/btn_coupon_three"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_coupons_text_size"
        android:textColor="@color/greyUnableText"
        android:gravity="center"
        android:id="@+id/btn_coupon_three"
        android:background="@drawable/button_transfer_coupon"
        android:padding="@dimen/coupon_transfer_btn_coupon_padding"
        android:layout_width="@dimen/coupon_transfer_btn_coupon_min_width"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_reg"
        android:layout_marginEnd="@dimen/coupon_transfer_btn_coupon_three_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_coupon_one"/>
    <ImageView
        android:id="@+id/iv_ic_metro"
        android:layout_width="@dimen/coupon_transfer_iv_ic_metro_width"
        android:layout_height="@dimen/coupon_transfer_iv_ic_metro_height"
        android:layout_marginTop="@dimen/coupon_transfer_iv_margin_top"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_view_text_size"
        android:textColor="@color/darkCharcoal"
        android:gravity="center"
        android:id="@+id/tv_withdraw_cashback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coupon_transfer_tv_withdraw_cashback_margin_top"
        android:text="Выводи кэшбэк ЧекСкана  на скидки в METRO!"
        android:fontFamily="@font/roboto_reg"
        android:layout_marginStart="@dimen/coupon_transfer_view_margin_start_end_bottom"
        android:layout_marginEnd="@dimen/coupon_transfer_view_margin_start_end_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_ic_metro"/>
    <ImageView
        android:id="@+id/iv_your_balance"
        android:layout_width="@dimen/coupon_transfer_iv_your_balance_width_height"
        android:layout_height="@dimen/coupon_transfer_iv_your_balance_width_height"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/margin_small_sm"
        app:layout_constraintBottom_toBottomOf="@+id/tv_your_balance"
        app:layout_constraintEnd_toStartOf="@+id/tv_your_balance"
        app:layout_constraintTop_toTopOf="@+id/tv_your_balance"
        app:srcCompat="@drawable/ic_limit_balance_coupon"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_view_text_size"
        android:textColor="@color/darkCharcoal"
        android:id="@+id/tv_your_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_big_sm"
        android:fontFamily="@font/roboto_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_withdraw_cashback"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_coupons_text_size"
        android:textColor="@color/greyUnableText"
        android:gravity="center"
        android:id="@+id/btn_coupon_one"
        android:background="@drawable/button_transfer_coupon"
        android:padding="@dimen/coupon_transfer_btn_coupon_padding"
        android:layout_width="@dimen/coupon_transfer_btn_coupon_min_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large"
        android:fontFamily="@font/roboto_reg"
        android:layout_marginStart="@dimen/coupon_transfer_view_margin_start_end_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_separator_balance"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_coupons_text_size"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_coupon_two"
        android:background="@drawable/button_transfer_coupon"
        android:padding="@dimen/coupon_transfer_btn_coupon_padding"
        android:layout_width="@dimen/coupon_transfer_btn_coupon_min_width"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintEnd_toStartOf="@+id/btn_coupon_three"
        app:layout_constraintStart_toEndOf="@+id/btn_coupon_one"
        app:layout_constraintTop_toTopOf="@+id/btn_coupon_one"/>
    <TextView
        android:textColor="@color/darkCharcoal80"
        android:gravity="center"
        android:id="@+id/tv_coupon_one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coupon_transfer_tv_margin_top_start"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintEnd_toEndOf="@+id/btn_coupon_one"
        app:layout_constraintStart_toStartOf="@+id/btn_coupon_one"
        app:layout_constraintTop_toBottomOf="@+id/btn_coupon_one"/>
    <TextView
        android:textColor="@color/darkCharcoal80"
        android:id="@+id/tv_coupon_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coupon_transfer_tv_margin_top_start"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintEnd_toEndOf="@+id/btn_coupon_two"
        app:layout_constraintStart_toStartOf="@+id/btn_coupon_two"
        app:layout_constraintTop_toBottomOf="@+id/btn_coupon_two"/>
    <View
        android:id="@+id/view_separator"
        android:background="@color/colorWhisper"
        android:layout_width="@dimen/coupon_transfer_view_width"
        android:layout_height="@dimen/coupon_transfer_view_separator_height"
        android:layout_marginTop="@dimen/coupon_transfer_view_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_two"/>
    <View
        android:id="@+id/view_separator_balance"
        android:background="@color/colorWhisper"
        android:layout_width="@dimen/coupon_transfer_view_width"
        android:layout_height="@dimen/coupon_transfer_view_separator_height"
        android:layout_marginTop="@dimen/margin_space_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_your_balance"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_view_text_size"
        android:textColor="@color/darkCharcoal"
        android:gravity="center"
        android:id="@+id/tv_per_amount"
        android:visibility="invisible"
        android:layout_width="@dimen/coupon_transfer_view_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coupon_transfer_view_margin_top"
        android:text="За 40 ₽ рублей вы получите"
        android:fontFamily="@font/roboto_medium"
        android:layout_marginStart="@dimen/coupon_transfer_view_margin_start_end_bottom"
        android:layout_marginEnd="@dimen/coupon_transfer_view_margin_start_end_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_separator"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_view_text_size"
        android:textColor="@color/darkCharcoal"
        android:gravity="center"
        android:id="@+id/tv_discount_amount"
        android:visibility="gone"
        android:layout_width="@dimen/coupon_transfer_view_width"
        android:layout_height="wrap_content"
        android:text="скидку в 100 ₽!"
        android:fontFamily="@font/roboto_bold"
        android:layout_marginStart="@dimen/coupon_transfer_view_margin_start_end_bottom"
        android:layout_marginEnd="@dimen/coupon_transfer_view_margin_start_end_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_per_amount"/>
    <com.warefly.checkscan.core.ui.LoadingButton
        android:id="@+id/btn_spend_amount"
        android:visibility="invisible"
        android:layout_width="@dimen/coupon_transfer_view_width"
        android:layout_height="@dimen/coupon_transfer_btn_spend_amount_height"
        android:layout_marginTop="@dimen/coupon_transfer_view_margin_top"
        android:text="@string/new_balance_transfer_coupon_get"
        android:layout_marginStart="@dimen/coupon_transfer_view_margin_start_end_bottom"
        android:layout_marginEnd="@dimen/coupon_transfer_view_margin_start_end_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_per_amount"
        style="@style/Button"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_view_text_size"
        android:textColor="@color/readilyBlue"
        android:id="@+id/btn_full_rules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coupon_transfer_tv_full_rules_margin_top_bottom"
        android:layout_marginBottom="@dimen/coupon_transfer_tv_full_rules_margin_top_bottom"
        android:text="TextView"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_spend_amount"/>
    <TextView
        android:textSize="@dimen/coupon_transfer_view_text_size"
        android:textColor="@color/darkCharcoal"
        android:id="@+id/tv_select_discount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_big_sm"
        android:text="@string/new_balance_transfer_coupon_select"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_separator_balance"/>
</androidx.constraintlayout.widget.ConstraintLayout>
