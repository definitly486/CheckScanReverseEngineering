<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_little_bit"
    app:cardCornerRadius="@dimen/margin_small_sm"
    app:cardElevation="@dimen/margin_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_title"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/tv_value"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guide"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/BonusesPreviewTitle"/>
        <TextView
            android:id="@+id/tv_value"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guide"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/BonusesPreviewValue"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.6"/>
        <com.warefly.checkscan.shimmer.ShimmerFrameLayout
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="@dimen/fill_free_space"
            app:layout_constraintBottom_toBottomOf="@+id/tv_value"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:background="@drawable/background_shimmer_rectangle_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.warefly.checkscan.shimmer.ShimmerFrameLayout>
        <ImageView
            android:layout_width="@dimen/margin_large"
            android:layout_height="@dimen/fill_free_space"
            android:src="@drawable/dashed_line"
            android:contentDescription="@null"
            android:rotation="90"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guide"
            app:layout_constraintStart_toStartOf="@+id/guide"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_fave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/bonuses_preview_padding"
            android:contentDescription="@string/content_description_favorite"
            app:layout_constraintEnd_toEndOf="@+id/guide"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_favorite"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
