        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large_sm"
        app:shimmer_duration="1000">
        <FrameLayout
            android:background="@drawable/background_shimmer_rectangle_placeholder"
            android:layout_width="@dimen/image_side_middle"
            android:layout_height="@dimen/margin_fourty_average"/>
    </com.warefly.checkscan.shimmer.ShimmerFrameLayout>
</LinearLayout>
