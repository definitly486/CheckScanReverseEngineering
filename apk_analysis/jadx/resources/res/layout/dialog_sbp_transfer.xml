<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/top_background"
        android:background="@drawable/bottom_sheet_top_background"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="@dimen/dimen_44"
        android:layout_height="@dimen/dimen_44"
        android:contentDescription="@string/content_description_close"
        android:layout_marginEnd="@dimen/dimen_6"
        app:layout_constraintBottom_toBottomOf="@+id/top_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_blue_44"/>
    <TextView
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/dimen_21"
        android:paddingBottom="@dimen/dimen_12"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dimen_50"
        app:layout_constraintEnd_toStartOf="@+id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize17.Medium.Gray100"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:background="@color/white"
        android:paddingBottom="@dimen/dimen_32"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        android:paddingHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_background"/>
    <include
        android:id="@+id/incld_loading"
        android:visibility="gone"
        layout="@layout/layout_spinner_loading"/>
</androidx.constraintlayout.widget.ConstraintLayout>
