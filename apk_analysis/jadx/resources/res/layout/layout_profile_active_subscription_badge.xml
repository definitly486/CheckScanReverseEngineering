<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_active"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/primary_10"
        app:cardCornerRadius="@dimen/dimen_16"
        app:cardElevation="@dimen/dimen_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_warning"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_32"
                android:adjustViewBounds="true"
                android:maxWidth="@dimen/dimen_62"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dimen_100"
                android:layout_marginStart="@dimen/dimen_16"
                style="@style/TextSize16.Medium.Gray100"/>
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/dimen_120"
                android:layout_weight="1"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/dimen_12"
                style="@style/TextSize14.Gray60"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_additional"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:paddingHorizontal="@dimen/dimen_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mcv_active">
        <TextView
            android:id="@+id/tv_left_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="textEnd"
            android:layout_marginEnd="@dimen/dimen_8"
            style="@style/TextSize14.Gray60"/>
        <ImageView
            android:id="@+id/iv_additional_icon"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_32"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/tv_right_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8"
            style="@style/TextSize14.Gray60"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
