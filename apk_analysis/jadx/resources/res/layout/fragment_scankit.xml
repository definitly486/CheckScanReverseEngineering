<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:animateLayoutChanges="true">
    <FrameLayout
        android:id="@+id/frame_scankit"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btn_back"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/content_description_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_back_white"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="btn_gallery,btn_by_hand,btn_flash"/>
    <TextView
        android:id="@+id/tv_flash"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:text="@string/scanner_flash"
        app:layout_constraintBottom_toBottomOf="@+id/btn_flash"
        app:layout_constraintEnd_toEndOf="@+id/btn_flash"
        app:layout_constraintStart_toStartOf="@+id/btn_flash"
        style="@style/ScannerButtonTitle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_flash"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_flash_off"/>
    <TextView
        android:id="@+id/btn_by_hand"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        android:text="@string/scanner_by_hand"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_flash"
        app:layout_constraintStart_toEndOf="@+id/btn_gallery"
        app:layout_constraintTop_toTopOf="@+id/btn_gallery"
        style="@style/ScannerButtonTitleBig"/>
    <TextView
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:text="@string/scanner_photo"
        app:layout_constraintBottom_toBottomOf="@+id/btn_gallery"
        app:layout_constraintEnd_toEndOf="@+id/btn_gallery"
        app:layout_constraintStart_toStartOf="@+id/btn_gallery"
        style="@style/ScannerButtonTitle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_gallery"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        android:tint="@color/grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_photo_gallery"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_scanner"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/view_side_huge"
        android:layout_height="@dimen/view_side_huge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/scanner"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_dot"
        android:visibility="gone"
        android:layout_width="@dimen/margin_big_sm"
        android:layout_height="@dimen/margin_big_sm"
        android:alpha="0.2"
        app:layout_constraintBottom_toBottomOf="@+id/iv_scanner"
        app:layout_constraintEnd_toEndOf="@+id/iv_scanner"
        app:layout_constraintStart_toStartOf="@+id/iv_scanner"
        app:layout_constraintTop_toTopOf="@+id/iv_scanner"
        app:srcCompat="@drawable/ic_bullet_full"/>
    <include
        android:id="@+id/permission_rationale"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        app:layout_constraintBottom_toBottomOf="@+id/barrier_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_try_new_scanner"
        layout="@layout/camera_permission_rationale_layout"/>
    <TextView
        android:textSize="@dimen/log_sign_in_text_size_medium"
        android:textColor="@color/white"
        android:id="@+id/btn_try_new_scanner"
        android:background="@drawable/rounded_clear_blue_rectangle"
        android:padding="@dimen/margin_small_2_sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        android:text="@string/scanner_try_new_scanner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"/>
</androidx.constraintlayout.widget.ConstraintLayout>
