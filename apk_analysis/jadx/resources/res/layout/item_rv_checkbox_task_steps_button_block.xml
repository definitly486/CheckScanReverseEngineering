<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_tick"
        android:layout_width="@dimen/dimen_24"
        android:layout_height="@dimen/dimen_24"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/step_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/step_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/step_container"
        android:padding="@dimen/dimen_16"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        android:paddingVertical="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_tick"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/TextSize16.Medium.Gray100"/>
        <com.warefly.checkscan.core.ui.LoadingButton
            android:enabled="false"
            android:id="@+id/btn_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:paddingHorizontal="@dimen/dimen_24"
            android:paddingVertical="@dimen/dimen_8"
            app:loadingDrawableResource="@drawable/loading_circles_8dp"
            app:regularDrawableResource="@drawable/regular_button_8dp"
            style="@style/Button.Blue.8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
