<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/margin_large_sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/margin_large_sm">
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_loading_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/margin_small_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_shops_gif"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ProductOffersTitle"/>
    <ImageView
        android:id="@+id/iv_shops_gif"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/margin_space_sm"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
