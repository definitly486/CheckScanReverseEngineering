<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_coupon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_banner"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:contentDescription="@null"
        android:layout_marginHorizontal="@dimen/margin_coupon_big"
        app:layout_constraintBottom_toTopOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/margin_enormous_sm"
        app:layout_constraintBottom_toTopOf="@+id/tv_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_banner"
        style="@style/CouponPromocodeTitle"/>
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_2_sm"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/margin_enormous_sm"
        app:layout_constraintBottom_toTopOf="@+id/tv_expiration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/CouponPromocodeDescription"/>
    <TextView
        android:id="@+id/tv_expiration"
        android:background="@drawable/background_athens_gray_16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_2_sm"
        android:layout_marginBottom="@dimen/margin_enormous_sm"
        android:maxLines="1"
        android:textAlignment="center"
        android:paddingHorizontal="@dimen/dimen_8"
        android:paddingVertical="@dimen/dimen_4"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"
        style="@style/TextSize14.ColorTextBody"/>
    <ImageView
        android:id="@+id/divider"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/margin_little_bit"
        android:src="@drawable/dashed_line"
        android:contentDescription="@null"
        android:layout_marginHorizontal="@dimen/margin_enormous_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5123"/>
    <FrameLayout
        android:id="@+id/layout_code"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_enormous_sm"
        android:layout_marginHorizontal="@dimen/margin_enormous_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <include
            android:id="@+id/layout_promocode"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_enormous_sm"
            layout="@layout/item_coupon_promocode"/>
        <include
            android:id="@+id/view_barcode"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/layout_barcode"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_qr_code"
            android:visibility="gone"
            android:layout_width="@dimen/fragment_coupon_image_side"
            android:layout_height="@dimen/fragment_coupon_image_side"
            android:layout_marginTop="@dimen/margin_1"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/iv_image_code"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/margin_1"
            android:contentDescription="@null"/>
    </FrameLayout>
    <com.warefly.checkscan.core.ui.LoadingButton
        android:id="@+id/btn_copy_code"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_enormous_sm"
        android:layout_marginBottom="@dimen/margin_fourty_large"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/coupon_code_copy_button"
        android:textAllCaps="false"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:stateListAnimator="@null"
        android:layout_marginHorizontal="@dimen/margin_enormous_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_code"
        app:regularDrawableResource="@drawable/electro_cheque_button"
        style="@style/BlueButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
