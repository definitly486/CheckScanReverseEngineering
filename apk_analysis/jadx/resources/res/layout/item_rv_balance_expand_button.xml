<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_horizontal_stroke"
    android:paddingTop="@dimen/margin_large_sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/margin_large_sm">
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_sm"
        android:textAlignment="center"
        app:drawableEndCompat="@drawable/ic_arrow_down"
        style="@style/TextSize14.ReadilyBlue"/>
</FrameLayout>
