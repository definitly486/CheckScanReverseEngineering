<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_simple_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/barrier_search"
        android:background="@color/white"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <View
            android:background="@drawable/background_search"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="44dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_search"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_search"/>
        <ImageView
            android:id="@+id/iv_search"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/fill_free_space"
            android:layout_marginTop="14.5dp"
            android:layout_marginBottom="14.49dp"
            android:contentDescription="@string/content_description_back"
            android:layout_marginStart="18.5dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_search"
            app:srcCompat="@drawable/ic_search"
            app:tint="@color/colorBlack40"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textColorHighlight="@color/colorAccent"
            android:textColorHint="@color/manatee"
            android:id="@+id/et_search"
            android:background="@null"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="44dp"
            android:minHeight="@dimen/margin_vast_big"
            android:hint="@string/choose_region_search_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:fontFamily="@font/roboto_reg"
            android:layout_marginStart="8.26dp"
            android:lineHeight="19sp"
            app:layout_constraintEnd_toStartOf="@+id/btn_remove_search"
            app:layout_constraintStart_toEndOf="@+id/iv_search"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_remove_search"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/fill_free_space"
            android:layout_marginTop="9.75dp"
            android:layout_marginBottom="9.28dp"
            android:contentDescription="@string/content_description_close"
            android:layout_marginEnd="10.51dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_search"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_search"
            app:srcCompat="@drawable/ic_close_black40"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:visibility="invisible"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/margin_top_sm"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="@+id/barrier_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <TextView
        android:id="@+id/tv_selected_region"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/iv_selected"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pb_loading"
        style="@style/DescriptiveLink"/>
    <ImageView
        android:id="@+id/iv_selected"
        android:padding="@dimen/activity_vertical_margin"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/tv_selected_region"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_selected_region"
        app:srcCompat="@drawable/ic_done"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_regions"
        android:paddingBottom="@dimen/margin_huge"
        android:clipToPadding="false"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        android:nestedScrollingEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_selected_region"/>
</androidx.constraintlayout.widget.ConstraintLayout>
