<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/navy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0.98">
    <TextView
        android:textSize="@dimen/log_sign_in_text_size_xlarge"
        android:textColor="@color/white"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6.7sp"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/tv_clarification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/log_sign_in_text_size_medium"
        android:textColor="@color/colorAccent"
        android:gravity="top|center_horizontal"
        android:id="@+id/tv_clarification"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        android:lineSpacingExtra="6.7sp"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/tv_fns_clarification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_greeting"/>
    <TextView
        android:textSize="@dimen/log_sign_in_text_size_medium"
        android:textColor="@color/colorAccent"
        android:gravity="top|center_horizontal"
        android:id="@+id/tv_fns_clarification"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        android:layout_marginTop="@dimen/margin_end_sm"
        android:lineSpacingExtra="10sp"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/btn_go"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_clarification"/>
    <Button
        android:enabled="true"
        android:id="@+id/btn_go"
        android:layout_width="@dimen/profile_view_button_width"
        android:layout_height="@dimen/profile_view_button_height"
        android:text="@string/sign_up_go"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_fns_clarification"
        style="@style/SignLogInButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
