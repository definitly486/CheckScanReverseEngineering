<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.hookedonplay.decoviewlib.DecoView
        android:layout_gravity="center"
        android:id="@+id/categories_expenses_pie_chart"
        android:layout_width="@dimen/categories_statistics_layout_categories_expenses_pie_chart_size"
        android:layout_height="@dimen/categories_statistics_layout_categories_expenses_pie_chart_size"
        android:layout_marginTop="@dimen/categories_statistics_layout_categories_expenses_pie_chart_margin_top"
        custom:dv_arc_gravity_horizontal="Left"
        custom:dv_arc_gravity_vertical="Top"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categories"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/categories_statistics_layout_rv_categories_margin_top"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toBottomOf="@+id/categories_expenses_pie_chart"/>
    <TextView
        android:textSize="@dimen/categories_statistics_layout_tv_expenses_chart_text_size"
        android:textColor="@color/blueCharcoal"
        android:id="@+id/tv_expenses_chart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/categories_statistics_layout_tv_expenses_chart_margin_top"
        android:text="@string/statistics_expenses_value"
        custom:layout_constraintEnd_toEndOf="@+id/categories_expenses_pie_chart"
        custom:layout_constraintStart_toStartOf="@+id/categories_expenses_pie_chart"
        custom:layout_constraintTop_toTopOf="@+id/categories_expenses_pie_chart"/>
    <TextView
        android:textSize="@dimen/categories_statistics_layout_tv_spent_label_text_size"
        android:textColor="@color/manatee"
        android:id="@+id/tv_spent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/categories_statistics_layout_tv_spent_label_margin_top"
        android:text="@string/statistics_expenses_title"
        custom:layout_constraintEnd_toEndOf="@+id/tv_expenses_chart"
        custom:layout_constraintStart_toStartOf="@+id/tv_expenses_chart"
        custom:layout_constraintTop_toBottomOf="@+id/tv_expenses_chart"/>
</androidx.constraintlayout.widget.ConstraintLayout>
