<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/colorTextBody"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_toolbar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scanner_onboarding_toolbar_title"
        android:paddingVertical="@dimen/margin_large_sm"
        style="@style/TextSize18.Medium.White"/>
    <ImageView
        android:id="@+id/iv_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:src="@drawable/image_scanner_onboarding"
        android:contentDescription="@null"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:text="@string/scanner_onboarding_title"
        android:layout_marginHorizontal="@dimen/margin_enormous_sm"
        style="@style/TextSize22.White"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/scanner_onboarding_description"
        android:layout_marginHorizontal="@dimen/margin_enormous_sm"
        style="@style/TextSize16.White"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/bnt_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:text="@string/scanner_onboarding_button_title"
        android:layout_marginHorizontal="@dimen/margin_top_medium_sm"
        style="@style/Button.Blue"/>
</LinearLayout>
