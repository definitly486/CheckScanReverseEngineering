<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view2"
        android:background="@drawable/bottom_sheet_top_background"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view3"
        android:background="@color/white"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="@dimen/dimen_44"
        android:layout_height="@dimen/dimen_44"
        android:contentDescription="@string/content_description_close"
        android:layout_marginEnd="@dimen/dimen_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_blue_44"/>
    <TextView
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/dimen_21"
        android:paddingBottom="@dimen/dimen_12"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dimen_44"
        app:layout_constraintEnd_toStartOf="@+id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize17.Medium.Gray100"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_hint"
        android:background="@drawable/background_babe_blue_stroke"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_info_blue"/>
        <TextView
            android:textColorHighlight="@android:color/transparent"
            android:textColorLink="@color/readilyBlue"
            android:id="@+id/tv_hint_transfer_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_only_phone_registration"
            android:layout_marginStart="@dimen/margin_small_2_sm"
            style="@style/UpridTextDescription"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_hint_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:text="@string/phone_tv_number_phone"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_hint"
        style="@style/UpridHintText"/>
    <com.google.android.material.textfield.TextInputLayout
        android:enabled="false"
        android:id="@+id/til_phone"
        android:background="@color/athensGray"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:boxBackgroundColor="@color/athensGray"
        app:errorEnabled="false"
        app:hintEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_hint_phone"
        app:layout_goneMarginTop="@dimen/margin_top_medium_sm"
        style="@style/TextInputLayout.Uprid">
        <com.google.android.material.textfield.TextInputEditText
            android:enabled="false"
            android:textColor="@color/manatee"
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:inputType="textCapSentences"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_transfer_destination"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/til_phone"
        style="@style/TextInputLayout.Disabled">
        <com.google.android.material.textfield.TextInputEditText
            android:textColor="@color/darkCharcoal"
            android:id="@+id/et_transfer_destination"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cursorVisible="false"
            android:inputType="phone"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_sum"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:hint="@string/transfer_cashback_sum_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/til_transfer_destination"
        style="@style/TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:textColor="@color/darkCharcoal"
            android:id="@+id/et_sum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:drawableEnd="@drawable/ic_ruble"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/tv_description"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/til_sum"
        style="@style/SimpleText.Centered"/>
    <View
        android:id="@+id/view"
        android:background="@color/colorWhisper"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/margin_1"
        android:layout_marginTop="@dimen/margin_sm"
        android:layout_marginStart="@dimen/margin_large_sm"
        android:layout_marginEnd="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/millionGrey"
        android:gravity="center"
        android:id="@+id/tv_rules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view"/>
    <include
        android:id="@+id/coupon_metro_view"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/margin_layout_height_more_big"
        android:layout_marginBottom="@dimen/margin_large_sm"
        android:layout_marginStart="@dimen/margin_large_sm"
        android:layout_marginEnd="@dimen/margin_large_sm"
        app:layout_constraintBottom_toTopOf="@+id/btn_transfer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_coupon_promocodes"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_promocodes"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fill_free_space"
        android:layout_marginBottom="@dimen/margin_large_sm"
        android:layout_marginStart="@dimen/margin_large_sm"
        android:layout_marginEnd="@dimen/margin_large_sm"
        app:layout_constraintBottom_toTopOf="@+id/btn_transfer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_rules"/>
    <com.warefly.checkscan.core.ui.LoadingButton
        android:enabled="false"
        android:id="@+id/btn_transfer"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_sm"
        android:text="@string/transfer_cashback_btn"
        android:layout_marginStart="@dimen/margin_large_sm"
        android:layout_marginEnd="@dimen/margin_large_sm"
        android:elevation="@dimen/margin_middle_little_bit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
