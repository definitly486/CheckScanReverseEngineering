<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_count"
        android:background="@drawable/background_blue_alice_radius_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_large_sm"
        android:paddingVertical="@dimen/margin_small_sm"
        style="@style/FragmentOfferCardRvItemButton"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        style="@style/FragmentOfferCardRvText"/>
</LinearLayout>
