<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:background="@color/athensGray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar_search"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/toolbar_search_new"/>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:visibility="invisible"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/margin_small_sm"
        android:indeterminate="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_search"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chips"
        android:background="@color/white"
        android:paddingTop="@dimen/margin_small_2_sm"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        android:overScrollMode="never"
        android:paddingStart="@dimen/margin_small_sm"
        android:paddingEnd="@dimen/margin_small_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_search"/>
    <com.warefly.checkscan.core.ui.SmartNestedScrollView
        android:id="@+id/smart_nested"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_search">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tv_header_product_in_cheque"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fragment_new_search_product_title"
                android:layout_marginHorizontal="@dimen/margin_large_sm"
                android:layout_marginVertical="@dimen/margin_end_sm"
                style="@style/HeaderRvSearchProducts"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_products"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_more_little_bit"
                android:overScrollMode="never"
                android:layout_marginHorizontal="@dimen/margin_large_sm"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <TextView
                android:id="@+id/tv_header_shop_in_cheque"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fragment_new_search_shop_title"
                android:layout_marginHorizontal="@dimen/margin_large_sm"
                android:layout_marginVertical="@dimen/margin_end_sm"
                style="@style/HeaderRvSearchProducts"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_shops"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_more_little_bit"
                android:overScrollMode="never"
                android:layout_marginHorizontal="@dimen/margin_large_sm"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </com.warefly.checkscan.core.ui.SmartNestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
