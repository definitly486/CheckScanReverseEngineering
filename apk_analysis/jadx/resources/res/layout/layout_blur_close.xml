    android:background="@drawable/background_circle_white_50_opacity_80"
    android:layout_width="@dimen/dimen_24"
    android:layout_height="@dimen/dimen_24"
    app:blurOverlayColor="#80ffffff">
    <LinearLayout
        android:gravity="center"
        android:layout_width="@dimen/dimen_24"
        android:layout_height="@dimen/dimen_24">
        <ImageView
            android:layout_width="@dimen/dimen_19"
            android:layout_height="@dimen/dimen_19"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_close_rounded"/>
    </LinearLayout>
