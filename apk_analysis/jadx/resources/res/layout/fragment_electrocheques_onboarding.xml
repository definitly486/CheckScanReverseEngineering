<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coord_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/toolbar_banner"
            android:background="@color/white"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_250"
            app:elevation="0dp">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:contentScrim="@color/readilyBlue"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                <ImageView
                    android:id="@+id/iv_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    app:layout_collapseMode="parallax"
                    app:srcCompat="@drawable/banner_electrocheques"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:fillViewport="true"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/view_corners"
                    android:background="@drawable/bottom_sheet_white_background"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_instructions_title"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/electro_cheque_instructions_title"
                    android:lineSpacingExtra="2sp"
                    android:fontFamily="@font/roboto_medium"
                    android:textAlignment="textStart"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_corners"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_insctructions"
                    android:background="@color/white"
                    android:paddingTop="24dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_instructions_title"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_questions_title"
                    android:background="@color/very_light_blue"
                    android:paddingTop="32dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/electro_cheque_questions_title"
                    android:lineSpacingExtra="2sp"
                    android:fontFamily="@font/roboto_medium"
                    android:textAlignment="textStart"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rv_insctructions"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_questions"
                    android:background="@color/very_light_blue"
                    android:paddingTop="16dp"
                    android:paddingBottom="100dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_questions_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_back_button"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/margin_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="@dimen/dimen_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/btn_connect"
            android:paddingTop="@dimen/margin_more_large_sm"
            android:paddingBottom="@dimen/margin_more_large_sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fragment_electrocheques_onboarding_btn_connect"
            style="@style/Button.Blue.8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
