<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/whiteSmoke"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/view_toolbar"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_text_toolbar"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:text="@string/affiliation_tv_title"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_toolbar"
        style="@style/TextSize22.BlueCharcoal"/>
    <TextView
        android:textColorHighlight="#00ffffff"
        android:id="@+id/tv_subtitle"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/affiliation_tv_subtitle"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TextSize16"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_link"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:boxBackgroundColor="@color/white"
        app:hintAnimationEnabled="false"
        app:hintEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
        style="@style/TextInputLayout.PasteLink">
        <com.google.android.material.textfield.TextInputEditText
            android:gravity="top"
            android:id="@+id/et_link"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/affiliation_placeholder"
            android:minLines="5"/>
    </com.google.android.material.textfield.TextInputLayout>
    <ImageView
        android:id="@+id/btn_clear_input"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_average_sm"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/margin_medium_sm"
        app:layout_constraintEnd_toEndOf="@+id/til_link"
        app:layout_constraintTop_toTopOf="@+id/til_link"
        app:srcCompat="@drawable/ic_clear"/>
    <TextView
        android:id="@+id/btn_copy_paste"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:text="@string/affiliation_btn_copy_paste"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/til_link"
        style="@style/BlueAliceButtonRadius8"/>
    <TextView
        android:enabled="false"
        android:id="@+id/btn_check"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:text="@string/affiliation_btn_check"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_copy_paste"
        style="@style/BlueButtonRadius8"/>
    <ProgressBar
        android:id="@+id/pb_link_check_in_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/btn_check"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_check"/>
</androidx.constraintlayout.widget.ConstraintLayout>
