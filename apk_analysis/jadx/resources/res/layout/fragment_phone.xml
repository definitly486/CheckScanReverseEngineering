<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/change_phone_view_fill_free_space"
        android:paddingStart="@dimen/change_phone_layout_padding_end_right"
        android:paddingEnd="@dimen/change_phone_layout_padding_end_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <TextView
            android:enabled="false"
            android:textSize="@dimen/change_phone_view_text_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_give_code"
            android:background="@drawable/electro_cheque_button"
            android:padding="@dimen/change_phone_btn_give_code_padding"
            android:layout_width="@dimen/change_phone_view_fill_free_space"
            android:layout_height="@dimen/change_phone_view_height"
            android:layout_marginBottom="@dimen/fragment_phone_btn_give_code_bottom_margin"
            android:text="@string/personal_data_edit_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:textSize="@dimen/change_phone_view_text_size"
            android:textColor="@color/darkCharcoal"
            android:id="@+id/et_number_phone"
            android:background="@drawable/property_edit_focus"
            android:layout_width="@dimen/change_phone_view_fill_free_space"
            android:layout_height="@dimen/change_phone_view_height"
            android:layout_marginTop="@dimen/change_phone_view_margin_top"
            android:ems="10"
            android:inputType="phone"
            android:fontFamily="@font/roboto_medium"
            android:paddingStart="@dimen/change_phone_et_phone_padding_start"
            android:paddingEnd="@dimen/change_phone_et_phone_change_padding_end"
            android:importantForAutofill="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_number_phone"/>
        <TextView
            android:textSize="@dimen/change_phone_tv_enter_text_size"
            android:textColor="@color/black"
            android:id="@+id/tv_input_your_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/change_phone_view_margin_top"
            android:text="@string/phone_tv_enter_your_phone"
            android:fontFamily="@font/roboto_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/change_phone_tv_number_text"
            android:textColor="@color/millionGrey"
            android:id="@+id/tv_number_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/change_phone_view_margin_top"
            android:text="@string/phone_tv_number_phone"
            android:fontFamily="@font/roboto_reg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_input_your_phone"/>
        <TextView
            android:textSize="@dimen/change_phone_tv_when_edit_number"
            android:textColor="@color/gray_electrocheque"
            android:id="@+id/tv_when_edit_number"
            android:visibility="gone"
            android:layout_width="@dimen/change_phone_view_fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/change_phone_et_phone_margin_top"
            android:text="@string/phone_when_edit_number"
            android:fontFamily="@font/roboto_reg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_number_phone"/>
        <include
            android:id="@+id/i_agree_received_electrocheques_via_layout"
            android:visibility="gone"
            android:layout_width="@dimen/change_phone_view_fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/change_phone_cb_i_agree_received_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_when_edit_number"
            layout="@layout/layout_i_agree_received_electrocheques_via"/>
        <ProgressBar
            android:id="@+id/pb_wait_code_electrocheque"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/btn_give_code"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?android:attr/progressBarStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/white"
            android:padding="@dimen/activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="enterAlways|scroll">
            <ImageView
                android:id="@+id/btn_back_phone"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/content_description_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_arrow_left"/>
            <TextView
                android:textSize="@dimen/change_phone_tv_title_text"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_title_phone"
                android:layout_width="@dimen/change_phone_view_fill_free_space"
                android:layout_height="wrap_content"
                android:text="@string/phone_tv_change_phone"
                android:fontFamily="@font/roboto_reg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
