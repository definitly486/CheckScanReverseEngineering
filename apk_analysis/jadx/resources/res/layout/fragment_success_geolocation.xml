<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/clarification_geolocation_layout_padding_start_end"
    android:paddingEnd="@dimen/clarification_geolocation_layout_padding_start_end">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_cloud_animation_success"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Image"/>
        <TextView
            android:id="@+id/tv_hooray_now_we"
            android:layout_width="wrap_content"
            android:text="@string/success_geolocation_hooray_now_we"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_cloud_animation_success"
            style="@style/HeaderHeight"/>
        <TextView
            android:id="@+id/btn_continue"
            android:background="@drawable/rounded_readily_blue_rect_3dp"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/success_geolocation_btn_continue_margin_top"
            android:text="@string/success_geolocation_continue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_hooray_now_we"
            style="@style/ButtonWidth.TextColor"/>
    </LinearLayout>
</ScrollView>
