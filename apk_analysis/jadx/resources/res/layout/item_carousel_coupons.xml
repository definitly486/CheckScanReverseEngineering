<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/carousel_coupons_item_width"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/carousel_coupons_item_margin_right"
    app:cardCornerRadius="@dimen/carousel_coupons_item_corner_radius"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view_colored_layer_coupon"
            android:background="@drawable/rounded_half_background"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/carousel_coupons_view_colored_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_logo_coupon"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/carousel_coupons_iv_logo_coupon_height"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/carousel_coupons_margin_left"
            app:layout_constraintBottom_toBottomOf="@+id/view_colored_layer_coupon"
            app:layout_constraintStart_toStartOf="@+id/view_colored_layer_coupon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/carousel_coupons_tv_description_text_size"
            android:textColor="@color/darkCharcoal"
            android:id="@+id/tv_description_coupon"
            android:layout_width="@dimen/carousel_coupons_tv_description_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carousel_coupons_margin_top"
            android:maxLines="2"
            android:layout_marginStart="@dimen/carousel_coupons_margin_left"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_colored_layer_coupon"/>
        <TextView
            android:textSize="@dimen/carousel_coupons_tv_term_text_size"
            android:textColor="@color/millionGrey"
            android:id="@+id/tv_term_coupon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carousel_coupons_tv_term_margin_top"
            android:layout_marginStart="@dimen/carousel_coupons_margin_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_description_coupon"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintGuide_end="@dimen/carousel_coupons_guideline_constraint_guide_end"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
