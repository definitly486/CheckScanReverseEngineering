<?xml version="1.0" encoding="utf-8"?>
<com.warefly.checkscan.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view_first_promocode"
            android:background="@drawable/background_shimmer_rectangle_placeholder"
            android:layout_width="160dp"
            android:layout_height="260dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toStartOf="@+id/view_second_promocode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_second_promocode"
            android:background="@drawable/background_shimmer_rectangle_placeholder"
            android:layout_width="160dp"
            android:layout_height="260dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view_first_promocode"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_third_promocode"
            android:background="@drawable/background_shimmer_rectangle_placeholder"
            android:layout_width="160dp"
            android:layout_height="260dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toStartOf="@+id/view_forth_promocode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_first_promocode"/>
        <View
            android:id="@+id/view_forth_promocode"
            android:background="@drawable/background_shimmer_rectangle_placeholder"
            android:layout_width="160dp"
            android:layout_height="260dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view_third_promocode"
            app:layout_constraintTop_toBottomOf="@+id/view_first_promocode"/>
        <View
            android:id="@+id/view_fifth_promocode"
            android:background="@drawable/background_shimmer_rectangle_placeholder"
            android:layout_width="160dp"
            android:layout_height="260dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toStartOf="@+id/view_sixth_promocode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_third_promocode"/>
        <View
            android:id="@+id/view_sixth_promocode"
            android:background="@drawable/background_shimmer_rectangle_placeholder"
            android:layout_width="160dp"
            android:layout_height="260dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view_fifth_promocode"
            app:layout_constraintTop_toBottomOf="@+id/view_third_promocode"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.warefly.checkscan.shimmer.ShimmerFrameLayout>
