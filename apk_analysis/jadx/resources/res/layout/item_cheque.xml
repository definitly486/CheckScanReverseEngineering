<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_cheque"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/black"
        android:id="@+id/tv_shop_name"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:singleLine="true"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintEnd_toStartOf="@+id/name_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ItemChequeViewMarginTop.MarginStart.MarginEnd"/>
    <ImageView
        android:id="@+id/iv_warning"
        android:background="@drawable/ic_warning"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/item_cheque_view_margin"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/dashed_borderline"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/margin_top_sm"
        android:src="@drawable/dashed_line"
        android:contentDescription="@null"
        android:layerType="software"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shop_name"
        style="@style/ItemChequeViewMarginTop.MarginStart.MarginEnd"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorBlack40"
        android:id="@+id/tv_date_time"
        android:paddingBottom="@dimen/margin_large_sm"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_reg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashed_borderline"
        style="@style/ItemChequeViewMarginTop.MarginStart"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:id="@+id/tv_sum"
        android:paddingBottom="@dimen/margin_large_sm"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium"
        android:textAlignment="textEnd"
        android:layout_marginEnd="@dimen/item_cheque_view_margin_start_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_date_time"
        app:layout_constraintTop_toBottomOf="@+id/dashed_borderline"
        style="@style/ItemChequeViewMarginTop"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_end_of_cheque"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_date_time,tv_sum "/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/name_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="tv_stock, iv_warning"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tv_stock"
        android:background="@drawable/rounded_red_rect_3dp"
        android:paddingTop="@dimen/item_cheque_tv_padding_top_bottom"
        android:paddingBottom="@dimen/item_cheque_tv_padding_top_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/roboto_medium"
        android:textAlignment="center"
        android:paddingStart="@dimen/margin_more_little_bit"
        android:paddingEnd="@dimen/margin_more_little_bit"
        android:layout_marginEnd="@dimen/item_cheque_view_margin_start_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ItemChequeViewMarginTop"/>
</androidx.constraintlayout.widget.ConstraintLayout>
