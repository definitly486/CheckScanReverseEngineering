<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="28dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/main_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/dimen_16"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/expires_orange"
        app:strokeWidth="@dimen/dimen_2">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/dimen_20"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dimen_20">
            <TextView
                android:id="@+id/tv_bank_name"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_20"
                android:layout_marginEnd="@dimen/dimen_130"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSize18.Medium.Black1000"/>
            <TextView
                android:id="@+id/tv_card_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/tv_bank_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_bank_name"
                style="@style/TextSize14.Black600"/>
            <TextView
                android:id="@+id/tv_first_label"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toStartOf="@+id/headers_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_card_type"
                style="@style/TextSize12.Black600"/>
            <TextView
                android:id="@+id/tv_first_value"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toStartOf="@+id/headers_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_first_label"
                style="@style/TextSize16.Medium.Black1000"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/headers_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"/>
            <TextView
                android:id="@+id/tv_second_label"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/headers_guideline"
                app:layout_constraintTop_toTopOf="@+id/tv_first_label"
                style="@style/TextSize12.Black600"/>
            <TextView
                android:id="@+id/tv_second_value"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_second_label"
                app:layout_constraintTop_toBottomOf="@+id/tv_second_label"
                style="@style/TextSize16.Medium.Black1000"/>
            <TextView
                android:id="@+id/tv_categories_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_first_value"
                style="@style/TextSize12.Black600"/>
            <ImageView
                android:id="@+id/iv_categories_info"
                android:visibility="gone"
                android:layout_width="@dimen/dimen_16"
                android:layout_height="@dimen/dimen_16"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/dimen_8"
                app:layout_constraintBottom_toBottomOf="@+id/tv_categories_title"
                app:layout_constraintStart_toEndOf="@+id/tv_categories_title"
                app:layout_constraintTop_toTopOf="@+id/tv_categories_title"
                app:srcCompat="@drawable/ic_question_gray_circle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/rv_categories"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_categories_title"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_categories"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="rv_categories, tv_categories_title"/>
            <TextView
                android:id="@+id/tv_steps_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_categories"
                style="@style/TextSize16.Medium.Gray100"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_steps_container"
                android:clipChildren="false"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:baselineAligned="false"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_steps_title">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="@dimen/dimen_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dimen_6">
                    <ImageView
                        android:id="@+id/iv_step_1"
                        android:layout_width="@dimen/dimen_0"
                        android:layout_height="@dimen/dimen_0"
                        android:importantForAccessibility="no"
                        app:layout_constraintDimensionRatio="148:60"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/tv_step_1_badge"
                        android:background="@drawable/bg_blue_circle"
                        android:visibility="gone"
                        android:layout_width="@dimen/dimen_22"
                        android:layout_height="@dimen/dimen_22"
                        android:layout_marginTop="-6dp"
                        android:text="1"
                        android:layout_marginStart="-6dp"
                        app:layout_constraintStart_toStartOf="@+id/iv_step_1"
                        app:layout_constraintTop_toTopOf="@+id/iv_step_1"
                        style="@style/TextSize12.Medium"/>
                    <TextView
                        android:id="@+id/tv_step_1_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_step_1"
                        style="@style/TextSize14.Black100"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="@dimen/dimen_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/iv_step_2"
                        android:layout_width="@dimen/dimen_0"
                        android:layout_height="@dimen/dimen_0"
                        android:importantForAccessibility="no"
                        app:layout_constraintDimensionRatio="148:60"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/tv_step_2_badge"
                        android:background="@drawable/bg_blue_circle"
                        android:visibility="gone"
                        android:layout_width="@dimen/dimen_22"
                        android:layout_height="@dimen/dimen_22"
                        android:layout_marginTop="-6dp"
                        android:text="2"
                        android:layout_marginStart="-6dp"
                        app:layout_constraintStart_toStartOf="@+id/iv_step_2"
                        app:layout_constraintTop_toTopOf="@+id/iv_step_2"
                        style="@style/TextSize12.Medium"/>
                    <TextView
                        android:id="@+id/tv_step_2_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_step_2"
                        style="@style/TextSize14.Black100"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/btn_issue_card"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_steps_container"
                style="@style/Button.Blue.8dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_psk_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_issue_card">
                <TextView
                    android:id="@+id/tv_psk_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextSize12.Gray40.Height16"/>
                <ImageView
                    android:textColorLink="@color/gray_40"
                    android:id="@+id/iv_psk_info"
                    android:layout_width="@dimen/dimen_16"
                    android:layout_height="@dimen/dimen_16"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/dimen_8"
                    app:srcCompat="@drawable/ic_question_gray_circle"/>
            </LinearLayout>
            <TextView
                android:textColorLink="@color/gray_40"
                android:id="@+id/tv_footer_disclaimer"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_4"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_psk_container"
                style="@style/TextSize12.Gray40.Height16"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_conditions"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_footer_disclaimer, ll_psk_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/iv_header_image"
        android:layout_width="@dimen/dimen_130"
        android:layout_height="@dimen/dimen_90"
        android:layout_marginTop="-28dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/dimen_12"
        app:layout_constraintEnd_toEndOf="@+id/main_card"
        app:layout_constraintTop_toTopOf="@+id/main_card"/>
    <LinearLayout
        android:id="@+id/ll_badge"
        android:background="@drawable/background_yellow_80"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-14dp"
        android:layout_marginStart="@dimen/dimen_12"
        android:paddingHorizontal="@dimen/dimen_12"
        android:paddingVertical="@dimen/dimen_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_badge"
            android:layout_width="@dimen/dimen_20"
            android:layout_height="@dimen/dimen_20"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4"
            style="@style/TextSize14.Medium.White"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
