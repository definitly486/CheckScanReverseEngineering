<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_babe_blue_stroke"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@null"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_transfer_card"/>
    <TextView
        android:textSize="@dimen/text_size_medium_small_sm"
        android:textColor="@color/blueCharcoal"
        android:id="@+id/tv_method"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_small_2_sm"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintEnd_toStartOf="@+id/iv_transfer_arrow"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
    <ImageView
        android:id="@+id/iv_transfer_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/margin_large_sm"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"
        app:srcCompat="@drawable/ic_arrow_right"/>
    <TextView
        android:textSize="@dimen/text_size_sm"
        android:textColor="@color/shuttleGray"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_sm"
        android:text="@string/balance_item_apply_for_card_title"
        android:layout_marginStart="@dimen/margin_large_sm"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_medium_small_sm"
        android:textColor="@color/colorTextBody"
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_more_little_bit"
        android:layout_marginBottom="@dimen/margin_small_sm"
        android:text="@string/balance_item_apply_for_card_subtitle"
        android:fontFamily="@font/roboto_medium"
        android:layout_marginStart="@dimen/margin_large_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_withdraw"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_method, iv_transfer_arrow"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_apply_for_method"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_title, tv_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
