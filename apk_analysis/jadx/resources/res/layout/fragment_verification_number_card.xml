<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/athensGray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layout_error"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_error_full_screen"/>
    <include
        android:id="@+id/toolbar"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_toolbar_back_icon"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:text="@string/fragment_confirm_number_card_sms_title"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/FragmentOfferCardTextTitle"/>
    <TextView
        android:id="@+id/tv_phone_number"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/VerificationTextNumber"/>
    <TextView
        android:textSize="@dimen/text_size_medium_small_sm"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_input_numbers"
        android:visibility="visible"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_2_sm"
        android:fontFamily="@font/roboto_reg"
        android:layout_marginHorizontal="@dimen/margin_top_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone_number"/>
    <ProgressBar
        android:id="@+id/pb_wait_sending_code"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_codes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/code_view_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_input_numbers">
        <EditText
            android:id="@+id/et_code_one_call"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:textIsSelectable="true"
            android:autofillHints="AUTOFILL_HINT_SMS_OTP"
            android:importantForAutofill="no"
            style="@style/EditCode.Title.Primary.Bold"/>
        <EditText
            android:id="@+id/et_code_two_call"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/code_et_code_margin_left_right"
            android:importantForAutofill="no"
            style="@style/EditCode.Title.Primary.Bold"/>
        <EditText
            android:id="@+id/et_code_three_call"
            android:visibility="gone"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/code_et_code_margin_left_right"
            android:importantForAutofill="no"
            style="@style/EditCode.Title.Primary.Bold"/>
        <EditText
            android:id="@+id/et_code_four_call"
            android:visibility="gone"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/code_et_code_margin_left_right"
            android:importantForAutofill="no"
            style="@style/EditCode.Title.Primary.Bold"/>
        <EditText
            android:id="@+id/et_code_five_call"
            android:visibility="gone"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/code_et_code_margin_left_right"
            android:importantForAutofill="no"
            style="@style/EditCode.Title.Primary.Bold"/>
        <EditText
            android:id="@+id/et_code_six_call"
            android:visibility="gone"
            android:ems="10"
            android:selectAllOnFocus="true"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/code_et_code_margin_left_right"
            android:importantForAutofill="no"
            style="@style/EditCode.Title.Primary.Bold"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_description_call"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_enormous_sm"
        android:text="@string/fragment_confirm_number_hint"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_codes"
        style="@style/VerificationTextDescription"/>
    <TextView
        android:id="@+id/tv_send_code_number"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_enormous_sm"
        android:text="@string/fragment_confirm_number_sms_send_code"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_codes"
        style="@style/VerificationTextDescription"/>
    <TextView
        android:id="@+id/tv_get_new_code"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:text="@string/fragment_confirm_number_sms_send_code_timer"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_repeat_send_code"
        style="@style/VerificationTextDescription"/>
    <TextView
        android:textColor="@color/statistics_chart_color_third"
        android:gravity="center"
        android:id="@+id/btn_repeat_send_code"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/fragment_confirm_number_sms_btn_repeat_title"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_send_code_number"
        style="@style/VerificationTextDescription"/>
    <TextView
        android:gravity="center"
        android:id="@+id/btn_request_call"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/fragment_confirm_number_sms_not_received"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_get_new_code"
        style="@style/VerificationTextDescription"/>
</androidx.constraintlayout.widget.ConstraintLayout>
