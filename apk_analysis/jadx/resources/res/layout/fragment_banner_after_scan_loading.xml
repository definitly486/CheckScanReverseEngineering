<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">
        <ImageView
            android:id="@+id/iv_splash_done"
            android:layout_width="@dimen/margin_fourty_large"
            android:layout_height="@dimen/margin_fourty_large"
            android:layout_marginTop="@dimen/margin_top_medium_sm"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:srcCompat="@drawable/ic_done_loading"/>
        <TextView
            android:id="@+id/tv_splash_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_splash_done"
            style="@style/TextSize18.Medium.BlueCharcoal"/>
        <TextView
            android:id="@+id/tv_splash_loading"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_enormous_sm"
            android:textAlignment="center"
            android:layout_marginHorizontal="@dimen/margin_60"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextSize16.BlueCharcoal"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_splash_loading"
            android:layout_width="@dimen/margin_295"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_sm"
            app:indicatorColor="@color/readilyBlue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_splash_loading"
            app:trackColor="@color/blueAlice"
            app:trackCornerRadius="@dimen/margin_small_sm"
            app:trackThickness="@dimen/margin_sm"/>
        <TextView
            android:id="@+id/tv_splash_secs_left"
            android:paddingBottom="@dimen/margin_sm"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_sm"
            android:text="@string/banner_after_scan_secs"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pb_splash_loading"
            style="@style/TextSize16.Medium.Manatee"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_done"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:constraint_referenced_ids="iv_splash_done, tv_splash_done"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_progress"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="pb_splash_loading, tv_splash_secs_left, tv_splash_loading"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_banner"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="@dimen/fill_free_space"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_splash_secs_left, tv_splash_done"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/banner_placeholder"
            android:visibility="gone"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="@dimen/fill_free_space"
            android:layout_marginTop="@dimen/margin_top_medium_sm"
            android:layout_marginBottom="@dimen/margin_top_medium_sm"
            android:layout_marginHorizontal="@dimen/margin_large_sm"
            app:layout_constraintBottom_toTopOf="@+id/btn_accept"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_banner">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/margin_little_bit"
                app:cardCornerRadius="@dimen/corner_radius_10"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/iv_picture"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="@dimen/fill_free_space"
                        android:src="@drawable/placeholder_poll"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <include
                        android:id="@+id/incld_ads_badge"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dimen_8"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
                        app:layout_constraintEnd_toEndOf="parent"
                        layout="@layout/layout_ads_badge"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/tv_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_big_sm"
                android:textAlignment="center"
                style="@style/TextSize16.ColorTextBody"/>
        </LinearLayout>
        <TextView
            android:id="@+id/btn_accept"
            android:visibility="gone"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_huge"
            android:text="@string/content_description_info"
            android:layout_marginHorizontal="@dimen/margin_large_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Button.Blue"/>
        <ImageView
            android:id="@+id/btn_close_splash"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_big_sm"
            android:contentDescription="@string/content_description_close"
            android:layout_marginEnd="@dimen/margin_large_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close_button_outlined"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_cheque_load"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageButton
            android:layout_gravity="end"
            android:id="@+id/btn_result_close"
            android:background="@drawable/background_blue_alice_radius_12_with_border"
            android:padding="@dimen/margin_small_sm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_big_sm"
            android:src="@drawable/ic_close_blue"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/margin_large_sm"/>
        <ImageView
            android:id="@+id/iv_scan_result_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_enormous_big_sm"
            android:contentDescription="@null"
            android:layout_marginHorizontal="@dimen/margin_space_sm"
            app:srcCompat="@drawable/img_coin_done_big"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/tv_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large_sm"
            android:text="@string/banner_after_scan_cheque_done"
            android:textAlignment="center"
            style="@style/TextSize24.BlueCharcoal.Height28"/>
    </LinearLayout>
    <include
        android:id="@+id/incld_loading_without_splash"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/layout_without_splash_banner_loading"/>
    <include
        android:id="@+id/incld_subscription_anon"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/anon_splash_scan_result"/>
</FrameLayout>
