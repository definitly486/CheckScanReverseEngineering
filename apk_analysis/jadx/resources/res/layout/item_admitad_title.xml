<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_white_background_with_shadow"
    android:paddingTop="@dimen/margin_large_sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_sm"
    android:layout_marginHorizontal="@dimen/margin_sm"
    android:paddingHorizontal="@dimen/margin_large_sm">
    <ImageView
        android:id="@+id/iv_shop"
        android:layout_width="@dimen/image_side_width_medium"
        android:layout_height="@dimen/margin_more_large"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="iv_shop"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_shop, tv_cashback_value,tv_fixed_cashback"/>
    <TextView
        android:textSize="@dimen/text_size_sm"
        android:textColor="@color/shuttleGray"
        android:id="@+id/tv_cashback_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_sm"
        android:layout_marginEnd="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_big"
        android:textColor="@color/black"
        android:id="@+id/tv_cashback_value"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium"
        android:textAlignment="textEnd"
        android:layout_marginStart="@dimen/margin_large_sm"
        android:layout_marginEnd="@dimen/margin_little_bit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/barrier"
        app:layout_constraintTop_toBottomOf="@+id/tv_cashback_title"/>
    <TextView
        android:id="@+id/tv_fixed_cashback"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:textAlignment="textEnd"
        android:layout_marginEnd="@dimen/margin_little_bit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier"
        app:layout_constraintTop_toBottomOf="@+id/tv_cashback_value"
        style="@style/TextSize24.Red"/>
    <TextView
        android:id="@+id/tv_expiration_date"
        android:background="@drawable/background_athens_gray_16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:paddingHorizontal="@dimen/dimen_8"
        android:paddingVertical="@dimen/dimen_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_shop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_shop"
        style="@style/TextSize14.ColorTextBody"/>
    <TextView
        android:id="@+id/tv_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fill_free_space"
        android:layout_marginTop="@dimen/margin_large_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier2"
        style="@style/AdmitadTextTitle"/>
    <TextView
        android:id="@+id/tv_description"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/AdmitadTextHeaderDescription"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_promo"
        android:background="@drawable/background_yellow_8"
        android:padding="@dimen/margin_small_2_sm"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_description">
        <ImageView
            android:id="@+id/ic_ru_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="@+id/tv_promo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_promo"
            app:srcCompat="@drawable/ic_yellow_ru_in_white_circle"/>
        <TextView
            android:textColorHighlight="@android:color/transparent"
            android:textColorLink="@color/white"
            android:id="@+id/tv_promo"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic_ru_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text16Weight500NormalWhite"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/incld_layout_powercode_hint"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_promo"
        layout="@layout/layout_powercode_description"/>
    <ImageView
        android:id="@+id/iv_banner"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/incld_layout_powercode_hint"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_redirect_hint"
        android:background="@drawable/background_babe_blue_stroke"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_banner">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_blue_info"/>
        <TextView
            android:id="@+id/tv_redirect_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small_2_sm"
            style="@style/UpridTextDescription"/>
    </LinearLayout>
    <TextView
        android:id="@+id/btn_check_cashback"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:text="@string/admitad_check_cashback_btn_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_redirect_hint"
        style="@style/Button.BlueAlice.8dp.Outlined"/>
    <TextView
        android:id="@+id/btn_go_shopping"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_check_cashback"
        style="@style/BlueButtonRadius8"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_more_cashback_description"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_go_shopping"
        style="@style/Button.BlueAlice.8dp.Outlined"/>
    <include
        android:id="@+id/view_rewards"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_more_cashback_description"
        layout="@layout/item_admitad_rewards"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="marquee"
        android:id="@+id/tv_ofd"
        android:padding="@dimen/margin_more_little_bit"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:drawablePadding="@dimen/margin_large_sm"
        android:marqueeRepeatLimit="marquee_forever"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        app:drawableEndCompat="@drawable/ic_info_gray_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_rewards"
        style="@style/OfdText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
