<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bankCardsBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_simple_title"/>
    <androidx.core.widget.NestedScrollView
        android:clipToPadding="false"
        android:layout_width="@dimen/fragment_bank_cards_free_space"
        android:layout_height="@dimen/fragment_bank_cards_free_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_bias="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_bank_options"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:visibility="invisible"
        android:layout_width="@dimen/fragment_bank_cards_free_space"
        android:layout_height="@dimen/fragment_bank_cards_progress_bar_height"
        android:indeterminate="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
