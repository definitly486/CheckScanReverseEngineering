<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_fourty_big"
        android:src="@drawable/image_scanner_onboarding_gallery"
        android:contentDescription="@null"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:text="@string/scanner_onboarding_gallery_title"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        style="@style/TextSize22.BlueCharcoal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_2_sm"
        android:text="@string/scanner_onboarding_gallery_description"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        style="@style/TextSize16"/>
    <View
        android:id="@+id/space"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_top_medium_sm"
        android:text="@string/scanner_onboarding_gallery_button_title"
        android:layout_marginHorizontal="@dimen/margin_large_sm"
        style="@style/Button.Blue"/>
</LinearLayout>
