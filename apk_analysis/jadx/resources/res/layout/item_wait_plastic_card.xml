<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/margin_small_sm">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header_card"
            android:background="@drawable/background_card_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_medium_sm"
                android:layout_marginBottom="@dimen/margin_enormous_sm"
                android:src="@drawable/ic_logo_with_text"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/margin_big_sm"
                app:layout_constraintBottom_toTopOf="@+id/view_bottom_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_mir_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_mir_logo"
                android:contentDescription="@null"
                android:layout_marginEnd="@dimen/margin_huge_sm"
                app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_logo"/>
            <View
                android:id="@+id/view_bottom_header"
                android:background="@drawable/background_white_top_16"
                android:layout_width="@dimen/fill_free_space"
                android:layout_height="@dimen/margin_big_sm"
                android:layout_marginBottom="-4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large_sm"
            style="@style/TextSize18.Medium.BlueCharcoal"/>
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large_sm"
            style="@style/TextSize16"/>
        <TextView
            android:id="@+id/btn_about_cash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alfa_item_about_cashback"
            android:textAlignment="center"
            android:layout_marginVertical="@dimen/margin_top_medium_sm"
            style="@style/ItemCardBalanceAbout"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
