<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_btn_back"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:paddingTop="@dimen/dimen_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dimen_16">
            <TextView
                android:id="@+id/tv_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support_form_header_title"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSize30.Medium"/>
            <TextView
                android:id="@+id/tv_name_hint"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:text="@string/support_form_name_hint_title"
                app:layout_constraintEnd_toEndOf="@+id/til_name"
                app:layout_constraintStart_toStartOf="@+id/til_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_header"
                style="@style/TextSize14.Gray60"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                app:errorIconDrawable="@null"
                app:expandedHintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_name_hint"
                style="@style/TextInputLayout16Corners">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/gray_80"
                    android:textColorHint="@color/gray_40"
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/support_form_name_field_hint_title"
                    android:singleLine="true"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/cursor_primary60"
                    style="@style/TextSize16.Gray60"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/tv_email_hint"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/support_form_email_hint_title"
                app:layout_constraintEnd_toEndOf="@+id/til_email"
                app:layout_constraintStart_toStartOf="@+id/til_email"
                app:layout_constraintTop_toBottomOf="@+id/til_name"
                style="@style/TextSize14.Gray60"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                app:errorIconDrawable="@null"
                app:expandedHintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_email_hint"
                style="@style/TextInputLayout16Corners">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/gray_80"
                    android:textColorHint="@color/gray_40"
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/support_form_email_field_hint_title"
                    android:singleLine="true"
                    android:inputType="textEmailAddress"
                    android:textCursorDrawable="@drawable/cursor_primary60"
                    style="@style/TextSize16.Gray60"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.warefly.checkscan.core.ui.CheckBox
                android:textColor="@drawable/checkbox_text_selector"
                android:textColorLink="@color/readilyBlue"
                android:gravity="center_vertical"
                android:id="@+id/cb_email_agreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:checked="false"
                android:button="@drawable/checkbox_square_selector"
                android:minHeight="@dimen/dimen_32"
                android:text="@string/support_form_email_checkbox_text"
                android:foregroundGravity="fill"
                android:paddingStart="@dimen/dimen_10"
                android:buttonTintMode="multiply"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/til_email"/>
            <TextView
                android:id="@+id/tv_description_hint"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/support_form_description_hint_title"
                app:layout_constraintEnd_toEndOf="@+id/til_description"
                app:layout_constraintStart_toStartOf="@+id/til_description"
                app:layout_constraintTop_toBottomOf="@+id/cb_email_agreement"
                style="@style/TextSize14.Gray60"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_description"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                app:errorIconDrawable="@null"
                app:expandedHintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_description_hint"
                style="@style/TextInputLayout16Corners">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/gray_80"
                    android:textColorHint="@color/gray_40"
                    android:gravity="start"
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dimen_128"
                    android:hint="@string/support_form_description_field_hint_title"
                    android:inputType="textMultiLine"
                    android:textCursorDrawable="@drawable/cursor_primary60"
                    style="@style/TextSize16.Gray60"/>
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.warefly.checkscan.core.ui.LoadingButton
        android:id="@+id/btn_confirm"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginBottom="@dimen/dimen_16"
        android:text="@string/support_form_button_text"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nested_scroll_view"
        app:loadingDrawableResource="@drawable/loading_circles_8dp"
        app:regularDrawableResource="@drawable/primary60_button_8dp"
        style="@style/Button.Primary60.8dp"/>
    <ImageView
        android:id="@+id/iv_btn_back"
        android:padding="@dimen/dimen_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left"/>
    <include
        android:id="@+id/incld_loading"
        android:visibility="gone"
        layout="@layout/layout_spinner_loading"/>
    <include
        android:id="@+id/incld_error"
        android:visibility="gone"
        layout="@layout/layout_simple_try_again"/>
</androidx.constraintlayout.widget.ConstraintLayout>
