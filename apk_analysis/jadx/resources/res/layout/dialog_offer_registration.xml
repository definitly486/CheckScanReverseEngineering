<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background_blue_alice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/profile_view_button_width"
        android:layout_marginTop="@dimen/margin_fourty_large"
        android:src="@drawable/ic_money_motivation"
        android:contentDescription="@null"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_2_sm"
        android:text="@string/dialog_offer_registration_title"
        style="@style/PgBonusDialogTextLargeTitle"/>
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_2_sm"
        android:text="@string/dialog_offer_registration_description"
        style="@style/DialogRegistrationCardTextDescription.Verification"/>
    <TextView
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:text="@string/dialog_offer_registration_button_confirm"
        android:layout_marginHorizontal="@dimen/margin_large"
        android:paddingVertical="@dimen/margin_medium_sm"
        style="@style/DialogRegistrationCardButton"/>
    <TextView
        android:id="@+id/btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_big_sm"
        android:layout_marginBottom="@dimen/margin_huge"
        android:text="@string/dialog_offer_registration_button_cancel"
        style="@style/PgBonusDialogTextPromotionTitle.Description"/>
</LinearLayout>
