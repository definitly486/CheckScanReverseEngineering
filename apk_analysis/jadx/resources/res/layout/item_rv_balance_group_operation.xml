<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_horizontal_stroke"
    android:paddingTop="@dimen/margin_small_2_sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize16.BlueCharcoal"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/margin_top_large_sm"
        android:layout_height="@dimen/margin_top_large_sm"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/activity_vertical_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_bullet_empty"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/margin_small_2_sm"
        android:layout_marginEnd="@dimen/margin_small_2_sm"
        app:layout_constraintEnd_toStartOf="@+id/tv_value"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_status"
        android:paddingBottom="@dimen/margin_small_2_sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_middle_little_bit"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_value"
        style="@style/TextSize14"/>
    <ImageView
        android:id="@+id/iv_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/margin_small_2_sm"
        app:layout_constraintBottom_toBottomOf="@+id/tv_expand"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/tv_expand"
        app:srcCompat="@drawable/ic_arrow_down_16"
        app:tint="@color/readilyBlue"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="tv_value,tv_status"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/readilyBlue"
        android:id="@+id/tv_expand"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_sm"
        android:layout_marginStart="@dimen/margin_more_little_bit"
        app:layout_constraintEnd_toStartOf="@+id/barrierEnd"
        app:layout_constraintStart_toEndOf="@+id/iv_expand"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TextSize14"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_expand,iv_expand,tv_status"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_suboperations"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrierBottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
