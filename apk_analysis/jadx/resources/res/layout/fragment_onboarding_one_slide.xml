<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/blue_onboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.warefly.checkscan.core.ui.SmartNestedScrollView
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        android:layout_marginBottom="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/btn_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_banner"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="@dimen/dimen_0"
                android:layout_marginTop="@dimen/dimen_44"
                android:contentDescription="@null"
                android:layout_marginHorizontal="@dimen/dimen_24"
                app:layout_constraintDimensionRatio="327:348"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.viewpager2.widget.ViewPager2
                android:orientation="vertical"
                android:id="@+id/vp_bank_slider"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="@dimen/dimen_348"
                android:layout_marginTop="@dimen/dimen_44"
                android:layout_marginHorizontal="@dimen/dimen_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.warefly.checkscan.ui.dotindicator.DotsIndicator
                android:id="@+id/vp_bank_slider_indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_8"
                app:dotsColor="@color/white50"
                app:dotsCornerRadius="@dimen/dimen_8"
                app:dotsSize="@dimen/dimen_8"
                app:dotsSpacing="@dimen/dimen_4"
                app:dotsWidthFactor="5"
                app:layout_constraintBottom_toBottomOf="@+id/vp_bank_slider"
                app:layout_constraintEnd_toEndOf="@+id/vp_bank_slider"
                app:layout_constraintTop_toTopOf="@+id/vp_bank_slider"
                app:orientation="vertical"
                app:progressMode="false"
                app:selectedDotColor="@color/white"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/banner_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="vp_bank_slider, iv_banner"/>
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/dimen_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/banner_barrier"
                style="@style/TextSize24.White"/>
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:layout_marginBottom="@dimen/dimen_24"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/dimen_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/TextSize16.White"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.warefly.checkscan.core.ui.SmartNestedScrollView>
    <TextView
        android:id="@+id/btn_primary"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_10"
        android:layout_marginHorizontal="@dimen/dimen_24"
        android:paddingHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/btn_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Button.White.Outlined"/>
    <TextView
        android:id="@+id/btn_secondary"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_24"
        android:paddingHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/spacer_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TransparentButton"/>
    <Space
        android:id="@+id/spacer_buttons"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_32"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageView
        android:id="@+id/btn_back"
        android:padding="@dimen/dimen_10"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_44"
        android:layout_height="@dimen/dimen_44"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left"
        app:tint="@color/white"/>
    <com.warefly.checkscan.ui.dotindicator.DotsIndicator
        android:id="@+id/dots_indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_18"
        app:dotsColor="@color/white50"
        app:dotsCornerRadius="@dimen/dimen_8"
        app:dotsSize="@dimen/dimen_8"
        app:dotsSpacing="@dimen/dimen_4"
        app:dotsWidthFactor="5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressMode="true"
        app:selectedDotColor="@color/white"/>
    <include
        android:id="@+id/incld_confetti"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/confetti_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
