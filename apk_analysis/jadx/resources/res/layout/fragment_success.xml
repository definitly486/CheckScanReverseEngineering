<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/margin_top_medium_sm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/fragment_poll_pass_layout_padding_end">
        <ImageView
            android:id="@+id/btn_close_success"
            android:layout_marginTop="@dimen/margin_big_sm"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close_blue"
            style="@style/BtnPollBlueAlice.BtnPollMarginStart.BtnPoll"/>
        <TextView
            android:textColor="@color/blueCharcoal"
            android:id="@+id/tv_success_title"
            android:layout_height="wrap_content"
            android:text="@string/add_screenshots_success_title"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_done_coin"
            style="@style/TvPollHeaderWidth.Header"/>
        <TextView
            android:textColor="@color/shuttleGray"
            android:id="@+id/tv_success_description"
            android:layout_width="@dimen/fragment_poll_pass_tv_your_limit_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fragment_poll_pass_tv_your_limit_margin_top"
            android:text="@string/add_screenshots_success_description"
            android:fontFamily="@font/roboto_reg"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/tv_success_title"
            app:layout_constraintStart_toStartOf="@+id/tv_success_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_success_title"/>
        <View
            android:id="@+id/v_space"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="@dimen/fill_free_space"
            app:layout_constraintBottom_toTopOf="@+id/btn_success_action"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_success_description"
            app:layout_constraintVertical_weight="1"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/btn_success_action"
            android:layout_width="@dimen/fragment_user_poll_view_width"
            android:layout_height="wrap_content"
            android:text="@string/add_screenshots_success_button_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_space"
            app:layout_constraintVertical_weight="1"
            style="@style/DefaultButton.BtnAgreement"/>
        <ImageView
            android:id="@+id/iv_done_coin"
            android:layout_width="@dimen/fragment_poll_pass_iv_poll_success_pass_size"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fragment_poll_pass_iv_poll_success_pass_margin_top"
            android:src="@drawable/ic_done_coin"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_close_success"
            app:srcCompat="@drawable/ic_done_coin"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
