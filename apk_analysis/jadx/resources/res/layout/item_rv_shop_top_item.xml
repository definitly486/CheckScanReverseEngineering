<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/background_white_stroke_pattens_blue"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:layout_weight="1">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_top_market"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fill_free_space"
        android:scaleType="centerCrop"
        android:layout_weight="1"
        android:contentDescription="@null"
        app:shapeAppearance="@style/ImageView.CornerTop8"/>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/tv_title"
        android:background="@color/pattensBlue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium"
        android:textAlignment="center"
        android:paddingVertical="@dimen/margin_more_little_bit"/>
</LinearLayout>
