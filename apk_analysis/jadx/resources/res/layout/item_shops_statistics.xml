<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/item_shops_statistics_layout_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_shop_statistics"
        android:layout_width="@dimen/item_shops_statistics_iv_shop_statistics_size"
        android:layout_height="@dimen/item_shops_statistics_iv_shop_statistics_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_placeholder_shop"/>
    <TextView
        android:textColor="@color/blueCharcoal"
        android:id="@+id/tv_shop_statistics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_reg"
        android:layout_marginStart="@dimen/item_shops_statistics_tv_shop_margin_start"
        app:layout_constraintStart_toEndOf="@+id/iv_shop_statistics"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/pb_costs_statistics"
        android:background="@drawable/line_progress_readily"
        android:layout_width="@dimen/item_shops_statistics_pb_costs_statistics_width"
        android:layout_height="@dimen/item_shops_statistics_pb_costs_statistics_height"
        android:layout_marginTop="@dimen/item_shops_statistics_pb_costs_statistics_margin_top"
        app:layout_constraintStart_toStartOf="@+id/tv_shop_statistics"
        app:layout_constraintTop_toBottomOf="@+id/tv_shop_statistics"/>
    <TextView
        android:textColor="#999da6"
        android:ellipsize="end"
        android:id="@+id/tv_cost_statistics"
        android:layout_width="@dimen/item_shops_statistics_tv_cost_statistics_width"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/roboto_reg"
        android:layout_marginStart="@dimen/item_shops_statistics_tv_cost_statistics_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/pb_costs_statistics"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pb_costs_statistics"
        app:layout_constraintTop_toTopOf="@+id/pb_costs_statistics"/>
</androidx.constraintlayout.widget.ConstraintLayout>
