<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    app:cardCornerRadius="@dimen/card_block_radius"
    app:cardElevation="@dimen/card_block_elevation">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="22sp"
            android:textColor="@color/black"
            android:id="@+id/tv_title"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_big_sm"
            android:text="@string/balance_new_withdraw_title"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="@dimen/margin_large_sm"
            android:layout_marginEnd="@dimen/margin_little_bit"
            app:layout_constraintEnd_toStartOf="@+id/iv_new_method"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_sm"
            android:textColor="@color/shuttleGray"
            android:id="@+id/tv_description"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_sm"
            android:text="@string/balance_new_withdraw_description"
            android:layout_marginStart="@dimen/margin_large_sm"
            android:layout_marginEnd="@dimen/margin_little_bit"
            app:layout_constraintEnd_toStartOf="@+id/iv_new_method"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_new_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ImageView.CornerLeft"
            app:srcCompat="@drawable/ic_new_method"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_withdraw"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_sm"
            android:layout_marginBottom="@dimen/margin_sm"
            android:layout_marginStart="@dimen/margin_sm"
            android:layout_marginEnd="@dimen/margin_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="@dimen/fill_free_space"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_description, iv_new_method"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
