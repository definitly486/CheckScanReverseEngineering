<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/activity_vertical_margin">
    <TextView
        android:textSize="@dimen/product_nearby_text_size_medium"
        android:textColor="@color/black"
        android:id="@+id/product_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_sm"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/product_item_text_size_small"
        android:textColor="@color/almostThereMoon"
        android:id="@+id/product_datetime"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_little_bit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_name"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="product_sum, product_price_units"/>
    <TextView
        android:textSize="@dimen/product_nearby_text_size_medium"
        android:textColor="@color/black"
        android:id="@+id/product_sum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_reg"
        android:textAlignment="textEnd"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="10.7sp"
        android:textColor="@color/colorDenimBlue"
        android:id="@+id/product_price_units"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fontFamily="@font/roboto_reg"
        android:textAlignment="textEnd"
        android:layout_marginStart="@dimen/margin_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_sum"/>
</androidx.constraintlayout.widget.ConstraintLayout>
