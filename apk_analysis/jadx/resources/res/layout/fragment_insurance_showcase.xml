<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/blueAlice"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_toolbar_title_18_transparent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:paddingBottom="@dimen/dimen_100"
        android:clipToPadding="false"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        android:paddingHorizontal="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <include
        android:id="@+id/incld_loading"
        android:visibility="gone"
        layout="@layout/layout_spinner_loading"/>
    <include
        android:id="@+id/incld_error"
        android:visibility="gone"
        layout="@layout/layout_simple_try_again"/>
</androidx.constraintlayout.widget.ConstraintLayout>
