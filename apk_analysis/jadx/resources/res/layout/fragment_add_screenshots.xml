<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_back_icon"/>
    <ScrollView
        android:background="@color/whiteSmoke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/margin_sm"
        android:paddingVertical="@dimen/margin_small_2_sm">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/margin_large_sm">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/margin_large_sm"
                    android:paddingVertical="@dimen/margin_big_sm">
                    <ImageView
                        android:id="@+id/iv_bank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@null"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_icon_bank_60"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_screenshot_bank_title"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:text="@string/add_screenshots_bank_title"
                        android:layout_marginStart="@dimen/margin_large_sm"
                        app:layout_constraintBottom_toTopOf="@+id/tv_screenshot_bank_description"
                        app:layout_constraintStart_toEndOf="@+id/iv_bank"
                        app:layout_constraintTop_toTopOf="@+id/iv_bank"
                        style="@style/TextSize16.Medium.BlueCharcoal"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_screenshot_bank_description"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:text="@string/add_screenshots_bank_description"
                        android:layout_marginStart="@dimen/margin_large_sm"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_bank"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_bank"
                        app:layout_constraintTop_toBottomOf="@+id/tv_screenshot_bank_title"
                        style="@style/TextSize14"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btn_load_screenshot_bank"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large_sm"
                        android:text="@string/add_screenshots_button_load_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/top_border_bottom"
                        style="@style/DefaultButton"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btn_screenshot_bank"
                        android:visibility="gone"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large_sm"
                        android:drawableEnd="@drawable/ic_edit_24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/top_border_bottom"
                        style="@style/BlueAliceButtonDefault"/>
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/top_border_bottom"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="@dimen/fill_free_space"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="tv_screenshot_bank_description,iv_bank"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_sm"
                app:cardCornerRadius="@dimen/margin_large_sm">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/margin_large_sm"
                    android:paddingVertical="@dimen/margin_big_sm">
                    <ImageView
                        android:id="@+id/iv_shop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@null"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_purchase_60"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_screenshot_shop_title"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:text="@string/add_screenshots_shop_title"
                        android:layout_marginStart="@dimen/margin_large_sm"
                        app:layout_constraintBottom_toTopOf="@+id/tv_screenshot_shop_description"
                        app:layout_constraintStart_toEndOf="@+id/iv_shop"
                        app:layout_constraintTop_toTopOf="@+id/iv_shop"
                        style="@style/TextSize16.Medium.BlueCharcoal"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_screenshot_shop_description"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:text="@string/add_screenshots_shop_description"
                        android:layout_marginStart="@dimen/margin_large_sm"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_shop"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_shop"
                        app:layout_constraintTop_toBottomOf="@+id/tv_screenshot_shop_title"
                        style="@style/TextSize14"/>
                    <com.warefly.checkscan.core.ui.SafeImageView
                        android:id="@+id/iv_shop_screenshot"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large_sm"
                        android:scaleType="fitCenter"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/top_border_bottom_shop"
                        app:srcCompat="@drawable/placehorder_screenshot"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btn_load_screenshot_shop"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large_sm"
                        android:text="@string/add_screenshots_button_load_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_shop_screenshot"
                        style="@style/DefaultButton"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btn_screenshot_shop"
                        android:visibility="gone"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large_sm"
                        android:drawableEnd="@drawable/ic_edit_24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_shop_screenshot"
                        style="@style/BlueAliceButtonDefault"/>
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/top_border_bottom_shop"
                        android:layout_width="@dimen/fill_free_space"
                        android:layout_height="@dimen/fill_free_space"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="tv_screenshot_shop_description,iv_shop"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_help_screenshots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_medium_sm"
                android:text="@string/add_screenshots_help"
                style="@style/NoBackgroundButton"/>
            <View
                android:layout_width="@dimen/fill_free_space"
                android:layout_height="@dimen/fill_free_space"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_upload"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_medium_sm"
                android:layout_marginBottom="@dimen/margin_enormous_sm"
                android:text="@string/add_screenshots_button_upload"
                style="@style/DefaultButton"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
