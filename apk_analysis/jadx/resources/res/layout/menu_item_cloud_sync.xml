<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ic_cloud"
        android:paddingTop="@dimen/margin_more_little_bit"
        android:layout_width="@dimen/margin_vast_big_sm"
        android:layout_height="@dimen/margin_vast_big_sm"
        android:layout_marginEnd="@dimen/margin_little_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cloud_sync"/>
    <ImageView
        android:id="@+id/iv_start_sync_btn"
        android:layout_width="@dimen/margin_golden_mean_sm"
        android:layout_height="@dimen/margin_golden_mean_sm"
        android:layout_marginTop="@dimen/margin_little_sm"
        android:layout_marginEnd="@dimen/margin_top_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_repeat"
        app:tint="@color/readilyBlue"/>
    <ProgressBar
        android:id="@+id/progress_notes_sync"
        android:visibility="gone"
        android:layout_width="@dimen/margin_golden_mean_sm"
        android:layout_height="@dimen/margin_golden_mean_sm"
        android:layout_marginTop="@dimen/margin_little_sm"
        android:layout_marginEnd="@dimen/margin_top_sm"
        android:progressTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
