<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/hint_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/powercode_square_logo_size"
        android:layout_height="@dimen/powercode_square_logo_size"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:layout_marginBottom="@dimen/margin_small_2_sm"
        android:src="@drawable/ic_powercode_square"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/margin_large_sm"
        app:layout_constraintBottom_toBottomOf="@+id/barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_sm"
        android:textColor="@color/colorTextBody"
        android:id="@+id/tv_powercode_description"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:layout_marginBottom="@dimen/margin_small_2_sm"
        android:layout_marginStart="@dimen/margin_large_sm"
        android:layout_marginEnd="@dimen/margin_large_sm"
        app:layout_constraintBottom_toBottomOf="@+id/barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_logo"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_logo, tv_powercode_description"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timer_container"
        android:background="@drawable/red_background_bottom_corners"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier">
        <TextView
            android:textSize="@dimen/text_size_sm"
            android:textColor="@color/white"
            android:id="@+id/tv_bottom_title"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_sm"
            android:layout_marginBottom="@dimen/margin_sm"
            android:text="@string/layout_powercode_description_bottom_title"
            android:layout_marginStart="@dimen/margin_small_2_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_bottom_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_sm"
            android:textColor="@color/white"
            android:id="@+id/tv_bottom_value"
            android:layout_width="@dimen/fill_free_space"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_sm"
            android:layout_marginBottom="@dimen/margin_sm"
            android:textAlignment="textEnd"
            android:layout_marginEnd="@dimen/margin_small_2_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_bottom_title"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
