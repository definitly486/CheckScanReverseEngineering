<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scrolled_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="@dimen/dimen_72"
                android:layout_height="@dimen/dimen_72"
                android:layout_marginTop="@dimen/dimen_44"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/img_checkscan_header"/>
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/auth_header_title"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/dimen_52"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_logo"
                style="@style/TextSize30.Medium.Black"/>
            <TextView
                android:id="@+id/tv_phone_title"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/auth_phone_field_title"
                app:layout_constraintEnd_toEndOf="@+id/til_phone"
                app:layout_constraintStart_toStartOf="@+id/til_phone"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/TextSize14.Gray60"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:layout_marginHorizontal="@dimen/dimen_16"
                app:errorIconDrawable="@null"
                app:expandedHintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_phone_title"
                app:prefixText="+7 "
                app:prefixTextAppearance="@style/TextInputLayout16CornersPrefix"
                app:prefixTextColor="@color/gray_100"
                app:startIconDrawable="@drawable/ic_russian_flag_with_start_margin"
                app:startIconTint="@null"
                style="@style/TextInputLayout16Corners">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/gray_80"
                    android:textColorHint="@color/gray_40"
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_phone_field_hint"
                    android:singleLine="true"
                    android:inputType="phone"
                    android:textCursorDrawable="@drawable/cursor_primary60"
                    style="@style/TextSize18.Medium.Gray100"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/btn_show_invite_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/auth_invite_code_field_show_button"
                android:layout_marginStart="@dimen/dimen_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/til_phone"
                style="@style/TextSize16.Primary60"/>
            <TextView
                android:id="@+id/tv_invite_code_title"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/auth_invite_code_field_title"
                app:layout_constraintEnd_toEndOf="@+id/til_invite_code"
                app:layout_constraintStart_toStartOf="@+id/til_invite_code"
                app:layout_constraintTop_toBottomOf="@+id/til_phone"
                style="@style/TextSize14.Gray60"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_invite_code"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:layout_marginHorizontal="@dimen/dimen_16"
                app:errorIconDrawable="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_invite_code_title"
                style="@style/TextInputLayout16Corners">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/gray_80"
                    android:textColorHint="@color/gray_40"
                    android:id="@+id/et_invite_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_invite_code_field_hint"
                    android:singleLine="true"
                    android:maxLength="24"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/cursor_primary60"
                    style="@style/TextSize18.Medium.Gray100"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier_invite_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="btn_show_invite_code, til_invite_code"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_invite_code"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="til_invite_code, tv_invite_code_title"/>
            <TextView
                android:id="@+id/btn_next"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/auth_button_next"
                android:layout_marginHorizontal="@dimen/dimen_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrier_invite_code"
                style="@style/Button.Primary60.8dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_agreements"
                android:clipToPadding="false"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:overScrollMode="never"
                android:layout_marginHorizontal="@dimen/dimen_16"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_next"/>
            <TextView
                android:id="@+id/btn_personal_data_policy"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/dimen_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_agreements"
                style="@style/TextSize14.Primary60"/>
            <TextView
                android:textSize="@dimen/dimen_14"
                android:id="@+id/btn_support_bottom"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_80"
                android:text="@string/auth_support_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_personal_data_policy"
                style="@style/TextSize14.Primary60"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:id="@+id/btn_back"
        android:padding="@dimen/dimen_10"
        android:layout_width="@dimen/dimen_44"
        android:layout_height="@dimen/dimen_44"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left"/>
    <TextView
        android:textSize="@dimen/dimen_14"
        android:id="@+id/btn_support"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_14"
        android:text="@string/auth_support_title"
        android:layout_marginEnd="@dimen/dimen_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize14.Primary60"/>
</androidx.constraintlayout.widget.ConstraintLayout>
