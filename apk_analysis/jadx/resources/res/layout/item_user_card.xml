<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ripple_pastel_blue_rectangle"
    android:paddingTop="@dimen/padding_sm"
    android:paddingBottom="@dimen/padding_sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/activity_vertical_margin"
    android:paddingEnd="@dimen/activity_vertical_margin">
    <ImageView
        android:id="@+id/iv_status"
        android:layout_width="@dimen/margin_top_large_sm"
        android:layout_height="@dimen/margin_top_large_sm"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_name"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium_sm"
        android:layout_marginEnd="@dimen/margin_medium_sm"
        app:layout_constraintEnd_toStartOf="@+id/btn_go"
        app:layout_constraintStart_toEndOf="@+id/iv_status"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OperationTitle"/>
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_sm"
        android:layout_marginEnd="@dimen/margin_medium_sm"
        app:layout_constraintEnd_toStartOf="@+id/btn_go"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/OperationSubtitle"/>
    <ImageView
        android:id="@+id/btn_go"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_right"/>
</androidx.constraintlayout.widget.ConstraintLayout>
