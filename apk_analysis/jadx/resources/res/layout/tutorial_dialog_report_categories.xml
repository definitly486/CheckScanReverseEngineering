<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/margin_overage">
    <ImageView
        android:id="@+id/btn_close"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="@dimen/margin_big_middle"
        android:layout_height="@dimen/margin_big_middle"
        android:contentDescription="@string/content_description_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/close"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/colorPrimary"
        android:id="@+id/title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_vertical_margin"
        android:text="@string/tutorial_categories_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/text"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:text="@string/tutorial_categories_text"
        android:layout_marginStart="@dimen/activity_vertical_margin"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <include
        android:id="@+id/category"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:layout_marginStart="@dimen/activity_vertical_margin"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"
        layout="@layout/item_category_in_cheque"/>
    <View
        android:id="@+id/view_selection"
        android:background="@color/colorClearBlueTrans"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        android:layout_marginStart="@dimen/activity_vertical_margin"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_name"/>
    <TextView
        android:textSize="@dimen/product_item_text_size_medium"
        android:textColor="@color/black"
        android:id="@+id/tv_name"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:text="@string/tutorial_categories_prod_name"
        android:layout_marginStart="@dimen/activity_vertical_margin"
        app:layout_constraintEnd_toStartOf="@+id/tv_sum_word"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category"/>
    <TextView
        android:textSize="@dimen/product_item_text_size_medium"
        android:textColor="@color/black"
        android:id="@+id/tv_sum_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tutorial_categories_cat_sum"
        android:fontFamily="@font/roboto_reg"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_name"/>
    <ImageView
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:layout_width="@dimen/margin_huge"
        android:layout_height="@dimen/margin_huge"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_sum_word"
        app:srcCompat="@drawable/ic_finger_swipe"/>
</androidx.constraintlayout.widget.ConstraintLayout>
