<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_header_card"
    android:background="@drawable/background_white_16_stroke_gray"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_background"
        android:background="@drawable/background_card_control"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="@+id/tv_control_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:paddingTop="@dimen/margin_big_sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_logo_with_mir"
        android:contentDescription="@null"
        android:paddingStart="@dimen/margin_big_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:id="@+id/tv_control_card"
        android:paddingBottom="@dimen/margin_big_sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/alfa_item_management_card_subtitle"
        android:maxLines="1"
        android:paddingStart="@dimen/margin_big_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_logo"
        style="@style/TextSize16.Medium.White"/>
    <ImageButton
        android:id="@+id/btn_control_card_action"
        android:background="@null"
        android:padding="@dimen/margin_sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right_white_24"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/tv_control_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_horizontal"
        android:id="@+id/btn_about_cash"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_top_medium_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_control_card"
        style="@style/TextSize16.Medium.ReadilyBlue"/>
</androidx.constraintlayout.widget.ConstraintLayout>
