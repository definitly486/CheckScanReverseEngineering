<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_50"
        android:layout_marginTop="@dimen/dimen_20"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        app:layout_constraintEnd_toStartOf="@+id/btn_fave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_power_code"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:src="@drawable/ic_powercode"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/dimen_12"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dimen_13"
        android:layout_marginStart="@dimen/dimen_3"
        app:layout_constraintBottom_toTopOf="@+id/tv_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guide"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TextSize14.Black30"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_value"
        android:paddingBottom="@dimen/dimen_16"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dimen_13"
        android:layout_marginStart="@dimen/dimen_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guide"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TextSize22.Black"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <ImageView
        android:layout_width="@dimen/dimen_50"
        android:layout_height="@dimen/dimen_0"
        android:src="@drawable/dashed_line"
        android:contentDescription="@null"
        android:rotation="90"
        android:layout_marginVertical="@dimen/dimen_20"
        app:layout_constraintBottom_toTopOf="@+id/tv_ofd"
        app:layout_constraintEnd_toEndOf="@+id/guide"
        app:layout_constraintStart_toStartOf="@+id/guide"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btn_fave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20"
        android:contentDescription="@null"
        android:layout_marginHorizontal="@dimen/dimen_13"
        app:layout_constraintEnd_toEndOf="@+id/guide"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_favorite"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="marquee"
        android:id="@+id/tv_ofd"
        android:padding="@dimen/dimen_4"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:drawablePadding="@dimen/dimen_16"
        android:marqueeRepeatLimit="marquee_forever"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:drawableEndCompat="@drawable/ic_info_gray_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ofd_barrier"
        style="@style/TextSize12"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/ofd_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_logo,tv_value"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_divider"
        android:background="@color/athensGrayButton"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_1"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
