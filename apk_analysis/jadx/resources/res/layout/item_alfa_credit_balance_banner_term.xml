<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/tv_bullet_point"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:src="@drawable/ic_bullet_full"
        android:contentDescription="@null"
        android:layout_marginHorizontal="@dimen/margin_small_sm"
        app:layout_constraintEnd_toStartOf="@+id/tv_term"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_term"/>
    <TextView
        android:id="@+id/tv_term"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_bullet_point"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextSize16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
