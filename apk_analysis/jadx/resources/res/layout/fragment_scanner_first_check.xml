<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/margin_large_sm">
    <ImageView
        android:id="@+id/btn_close"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_blue"
        style="@style/BtnPollBlueAlice.BtnPollMarginStart.BtnPoll"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_placeholder"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/margin_overage"
        android:layout_marginTop="@dimen/margin_height_large"
        android:src="@drawable/ic_rub_in_yellow"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_loop="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_enormous_sm"
        android:text="@string/scanned_first_check_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_placeholder"
        style="@style/TextSize22.BlueCharcoal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_description"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/scanned_first_check_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TextSize16.BlueCharcoal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_action"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium_sm"
        android:text="@string/scanned_first_check_button_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"
        style="@style/Button.Blue"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scanned_first_check_sub_description"
        app:layout_constraintBottom_toBottomOf="@+id/progress_circular"
        app:layout_constraintEnd_toStartOf="@+id/progress_circular"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/progress_circular"
        style="@style/TextSize14.ColorTextBody"/>
    <ProgressBar
        android:id="@+id/progress_circular"
        android:layout_width="@dimen/margin_top_medium_sm"
        android:layout_height="@dimen/margin_top_medium_sm"
        android:layout_marginTop="@dimen/margin_large_sm"
        android:layout_marginHorizontal="@dimen/margin_sm"
        app:layout_constraintEnd_toStartOf="@+id/tv_count"
        app:layout_constraintStart_toEndOf="@+id/tv_transaction"
        app:layout_constraintTop_toBottomOf="@+id/btn_action"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scanned_first_check_counter"
        app:layout_constraintBottom_toBottomOf="@+id/progress_circular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/progress_circular"
        app:layout_constraintTop_toTopOf="@+id/progress_circular"
        style="@style/TextSize14.ColorTextBody"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_count,progress_circular,tv_transaction"/>
</androidx.constraintlayout.widget.ConstraintLayout>
