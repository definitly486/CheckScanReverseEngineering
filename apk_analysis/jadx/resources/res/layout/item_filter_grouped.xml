<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/btn_show_subcats"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="@dimen/fill_free_space"
        app:layout_constraintBottom_toBottomOf="@+id/tv_group_name"
        app:layout_constraintEnd_toEndOf="@+id/iv_show_subcats"
        app:layout_constraintStart_toStartOf="@+id/tv_group_name"
        app:layout_constraintTop_toTopOf="@+id/tv_group_name"/>
    <TextView
        android:id="@+id/tv_group_name"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/iv_show_subcats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BasicFilter"/>
    <ImageView
        android:id="@+id/iv_show_subcats"
        android:padding="@dimen/padding_sm"
        android:layout_width="@dimen/margin_top_large_sm"
        android:layout_height="@dimen/fill_free_space"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/tv_group_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_group_name"
        app:srcCompat="@drawable/ic_arrow_down"
        app:tint="@color/almostThereMoon"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_subcategories"
        android:background="@color/colorBackgroundGrey"
        android:visibility="gone"
        android:layout_width="@dimen/fill_free_space"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_group_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
